#!/usr/bin/env bash
# Test stub: records the request (and a body piped via @-) and answers with $STUB_CURL_BODY, by
# default a body that satisfies every caller (an OAuth client, a token, a key id, a powered-off
# server whose disk snapshot is ready, that snapshot as dev1's only one, and a Contabo standard
# image); STUB_FAIL containing "curl" makes it fail like a rejected credential, and the first request
# whose URL ends in STUB_CURL_FAIL_ONCE fails like a dropped connection.
default='{"id":"kid","key":"tskey-client-k","access_token":"at","devices":[],"servers":[{"id":7}],"server":{"status":"off"},"image":{"id":"4711","status":"available"},"images":[{"id":4711,"description":"node-ctl dev1"}],"data":[{"imageId":"img-ubuntu-24.04","name":"ubuntu-24.04"}]}'
echo "curl: $*" >> "$STUB_LOG"
[[ "$*" != *"@-"* ]] || cat >> "$STUB_LOG"
[[ " ${STUB_FAIL:-} " != *" curl "* ]] || { echo "curl: (22) 401 Unauthorized" >&2; exit 22; }
[[ " ${STUB_FAIL:-} " != *" curl-devices "* || "$*" != *"/devices"* ]] || { echo "curl: (22) 403 Forbidden" >&2; exit 22; }
if [ -n "${STUB_CURL_FAIL_ONCE:-}" ] && [[ "$*" == *"$STUB_CURL_FAIL_ONCE" ]] && [ ! -e "$STUB_LOG.failed-once" ]; then
  touch "$STUB_LOG.failed-once"
  echo "curl: (6) Could not resolve host: api.hetzner.cloud" >&2
  exit 6
fi
# Contabo's instance list answers with the name it was searched by, so a power action finds one,
# in the status STUB_CONTABO_STATUS (running by default: provisioning is over) and with the add-ons
# STUB_CONTABO_ADDONS (the firewall's by default)
if [ -z "${STUB_CURL_BODY:-}" ] && [[ "$*" == *displayName=* ]]; then
  args="$*" # "${*##...}" would strip the prefix off every argument, not off the whole line
  name=${args##*displayName=}
  addons=${STUB_CONTABO_ADDONS:-'[{"id":1501,"quantity":1}]'}
  echo "{\"data\":[{\"instanceId\":99,\"displayName\":\"${name%% *}\",\"status\":\"${STUB_CONTABO_STATUS:-running}\",\"addOns\":$addons}]}"
  exit
fi
# Contabo's API spec documents the products only as a table in createInstance's description
if [ -z "${STUB_CURL_BODY:-}" ] && [[ "$*" == *api-v1.yaml* ]]; then
  cat <<'SPEC'
paths:
  /v1/compute/instances:
    post:
      description: >-
        Create a new instance. <table> <tr><th>ProductId</th><th>Product</th><th>Disk Size</th></tr>
        <tr><td>V153</td><td>Cloud VPS 4</td><td>100 GB SSD</td></tr> <tr><td>V159</td><td>Cloud VPS Plus 4</td><td>150 GB NVMe</td></tr>
        <tr><td>V93</td><td>VPS 10 Storage</td><td>300 GB SSD</td></tr> <tr><td>V16</td><td>VDS XXL</td><td>720 GB NVMe</td></tr> </table>
SPEC
  exit
fi
echo "${STUB_CURL_BODY:-$default}"
