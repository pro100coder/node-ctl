# --- progress: every operational line belongs to an action; a Node renderer draws the events ---
# Actions nest through a stack of ids; child-process output is tagged line by line with the action
# that ran it. Bodies of with_action run with errexit off (bash: any command under || does), so a
# body chains with && or calls die. See docs/adr/0010.

ACTIONS='' # stack of open action ids, innermost last
AID=0
PLANNED='' # "<parent>|<name>|<id>" per pending step, one per line (tabs would be IFS whitespace and collapse)
FAIL_MESSAGE='' # a body sets it before returning non-zero; the failed event carries it
EVENTS_FIFO='' RENDERER_PID=''

open_renderer() { # the renderer reads events from fd 3; started on the first event, waited for at exit
  [ -z "$EVENTS_FIFO" ] || return 0
  local nocolor=1 columns=80 screen=2 log=''
  [ "${NODE_CTL_COLOR:-}" != 1 ] || nocolor=''
  [ -z "$COLUMNS_TTY" ] || columns=$COLUMNS_TTY
  # Ten frames a second through the tee made the log gigabytes and kept only a failed step's last lines;
  # whatever the mode, the screen gets the drawing and the log every line, plain and stamped with the time.
  [ -z "$SCREEN" ] || { screen=$SCREEN; log=--log=$LOG; }
  EVENTS_FIFO=$(mktemp -d)/events
  mkfifo "$EVENTS_FIFO"
  # The renderer ignores SIGINT: Ctrl+C reaches the foreground command, node-ctl emits cancelled, the renderer draws it.
  (trap "" INT; NO_COLOR=$nocolor COLUMNS=$columns exec node progress/src/cli.ts "--progress=$PROGRESS" ${log:+"$log"}) < "$EVENTS_FIFO" 2>&"$screen" 1>&2 &
  RENDERER_PID=$!
  exec 3> "$EVENTS_FIFO"
}
close_renderer() {
  [ -n "$EVENTS_FIFO" ] || return 0
  exec 3>&-
  wait "$RENDERER_PID" 2>/dev/null || true
  rm -rf "${EVENTS_FIFO%/events}"
  EVENTS_FIFO=''
}

emit() { # emit <id> <event_type> [extra json fields]
  local v name key parent index total
  open_renderer
  v=ANAME_$1 name=${!v:-}
  v=AKEY_$1 key=${!v:-}
  v=APARENT_$1 parent=${!v:-}
  v=AINDEX_$1 index=${!v:-}
  v=ATOTAL_$1 total=${!v:-}
  emit_event "$1" "$parent" "$name" "$key" "$index" "$total" "$2" "${3:-}"
}

plan() { # plan <name> ...: pending steps under the current action, numbered [n/N]
  local i=0 n=$# name id parent=${ACTIONS##* }
  for name in "$@"; do
    i=$((i + 1)) AID=$((AID + 1)) id=a$AID
    eval "ANAME_$id=\$name AKEY_$id=\$(slug \"\$name\") APARENT_$id=\$parent AINDEX_$id=$i ATOTAL_$id=$n"
    PLANNED="$PLANNED$parent|$name|$id
"
    emit "$id" planned
  done
}

with_action() { # with_action <name> <key> <command ...>: started, then completed or failed by exit status
  local name=$1 key=$2 id='' parent=${ACTIONS##* } rc=0 p n i
  shift 2
  while IFS='|' read -r p n i; do [ "$p|$n" != "$parent|$name" ] || id=$i; done <<< "$PLANNED"
  if [ -z "$id" ]; then AID=$((AID + 1)) id=a$AID; fi
  eval "ANAME_$id=\$name AKEY_$id=\$key APARENT_$id=\$parent"
  ACTIONS="$ACTIONS $id"
  emit "$id" started
  FAIL_MESSAGE=''
  "$@" || rc=$?
  ACTIONS=${ACTIONS% *}
  if [ "$rc" -eq 0 ]; then emit "$id" completed
  else emit "$id" failed "\"message\":$(json_str "${FAIL_MESSAGE:-$name exited with status $rc}")"; fi
  return "$rc"
}

action_log() { emit "${ACTIONS##* }" log "\"message\":$(json_str "$*")"; }
action_warn() { emit "${ACTIONS##* }" warning "\"message\":$(json_str "$*")"; }
action_progress() { emit "${ACTIONS##* }" progress "\"current\":$1,\"total\":$2${3:+,\"message\":$(json_str "$3")}"; }

tag() { # tag <id> <stream>: every line on stdin becomes a log event of that action
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    emit "$1" log "\"stream\":\"$2\",\"message\":$(json_str "$line")"
  done
}
action_run() { # action_run <command ...>: the command's stdout and stderr are logs of the current action
  local id=${ACTIONS##* }
  { "$@" 2>&1 1>&4 4>&- | tag "$id" stderr 4>&-; } 4>&1 | tag "$id" stdout
}

settle_open() { # settle_open failed|cancelled <message>: innermost first, then the ancestors
  local id inner=''
  while [ -n "$ACTIONS" ]; do
    id=${ACTIONS##* }
    ACTIONS=${ACTIONS% *}
    case $1 in
      failed) emit "$id" failed "\"message\":$(json_str "${inner:-$2}")"; local v=ANAME_$id; inner="${!v:-} failed" ;;
      *) emit "$id" cancelled ;;
    esac
  done
}

on_exit() {
  local rc=$1
  [ -z "$ACTIONS" ] || settle_open failed "exited with status $rc"
  close_renderer
  log "=== exit $rc"
}
on_int() { # Ctrl+C: the foreground command is already dead, the open actions are cancelled
  settle_open cancelled
  exit 130
}
trap 'on_exit $?' EXIT
trap on_int INT

die() {
  [ -z "$ACTIONS" ] || settle_open failed "$*"
  close_renderer # the final frame lands before the message
  echo "node-ctl: $*" >&2
  exit 1
}
warn() { if [ -n "$ACTIONS" ]; then action_warn "$*"; else echo "node-ctl: $*" >&2; fi; }
info() { if [ -n "$ACTIONS" ]; then action_log "$*"; else echo "$*" >&2; fi; } # narration: stdout is for results only
need() { [ -n "${1:-}" ] || die "usage: ./node-ctl $cmd $2"; } # need "${1:-}" "<name> ...": a missing argument is a usage error, not a bash one
confirm() { # confirm <question> <word>: asked on a terminal, answered by --yes anywhere else
  local answer=
  [ "$YES" -eq 0 ] || return 0
  [ -t 0 ] || die "no terminal to confirm on; pass --yes"
  read -r -p "$1 Type $2 to confirm: " answer || true
  [ "$answer" = "$2" ] || die "aborted"
}

# Every question with a list of answers is a menu: arrows (or j/k, PgUp/PgDn) move, enter picks,
# q cancels. The list can be longer than the terminal, so it is a window that follows the selection
# instead of a list that scrolls its header away. Keys only: no pager, no curses, nothing on the host
# that ./node-ctl does not already need. It is redrawn in place, which needs a terminal on both ends
# and lines that do not wrap; anywhere else it is the numbered list and a typed answer, a number or
# the value itself. The caller declares the lists as locals:
#   MENU_VALUES  what each line answers         MENU_LINES  what is shown for it
#   MENU_HEADER  a title row above the lines    MENU_HINT   what a mark in the lines means
#   MENU_SKIP    " 3 5 ": lines shown dimmed that the selection walks past (they cannot be picked)
#   MENU_ANY     a last line that asks for an answer the list does not have
MENU_VALUES=() MENU_LINES=() MENU_HEADER='' MENU_HINT='' MENU_SKIP='' MENU_ANY=''
menu_driven() { [ -n "$TTY" ] && [ -t 0 ] && [ "${COLUMNS_TTY:-0}" -ge 50 ] 2>/dev/null; }
menu_ok() { [[ $MENU_SKIP != *" $1 "* ]]; }
menu() { # menu <question> [default value]: the answer on stdout, the menu on stderr; 1 when cancelled
  local question=$1 n=${#MENU_VALUES[@]} sel=0 i answer
  for (( i = 1; i <= n; i++ )); do # the default, else the first line that can be picked
    menu_ok "$i" || continue
    [ "$sel" -ne 0 ] || sel=$i
    [ "${MENU_VALUES[i-1]}" != "${2:-}" ] || sel=$i
  done
  [ "$sel" -ne 0 ] || [ -n "$MENU_ANY" ] || return 1
  if ! menu_driven; then
    [ -z "$MENU_HEADER" ] || printf '\n     %s\n' "$MENU_HEADER" >&2
    for (( i = 1; i <= n; i++ )); do printf '  %2d)%s\n' "$i" "${MENU_LINES[i-1]}" >&2; done
    [ "$sel" -eq 0 ] || answer=${MENU_VALUES[sel-1]}
    read -r -p "$question or number [$answer]: " answer || return 1
    case ${answer:-$sel} in
      0) ;; # nothing pickable and nothing typed
      *[!0-9]*) printf '%s\n' "$answer" ;; # the caller decides what an answer outside the list means
      *) answer=${answer:-$sel}; [ "$answer" -gt "$n" ] || printf '%s\n' "${MENU_VALUES[answer-1]}" ;;
    esac
    return
  fi
  close_renderer # it writes to the same terminal: a menu drawn under it would be torn apart
  if [ -n "$MENU_ANY" ]; then
    MENU_VALUES[n]='' MENU_LINES[n]=" $MENU_ANY"
    n=$((n + 1))
    [ "$sel" -ne 0 ] || sel=$n
  fi
  sel=$(menu_window "$question" "$n" "$sel") || return 1
  if [ -n "$MENU_ANY" ] && [ "$sel" -eq "$n" ]; then
    read -r -p "  $question: " answer || return 1
    printf '%s\n' "$answer"
  else
    printf '%s\n' "${MENU_VALUES[sel-1]}"
  fi
}
menu_window() { # menu_window <question> <lines> <selected>: the line picked on stdout
  local question=$1 lines=$2 sel=$3 top height width drawn=0 asked i step dir key esc hl='' off='' line
  [ "${NODE_CTL_COLOR:-}" != 1 ] || { hl=$'\e[7m' off=$'\e[0m'; }
  width=$(( COLUMNS_TTY - 4 )) # a line that wraps breaks the redraw: cut it instead
  height=$({ stty size </dev/tty | cut -d' ' -f1; } 2>/dev/null || echo 24)
  [ "${height:-0}" -ge 10 ] 2>/dev/null || height=24 # no size to be had (a pty without one)
  height=$((height - 6))
  [ "$height" -ge 3 ] || height=3
  [ "$height" -le "$lines" ] || height=$lines
  top=$(( sel - height / 2 ))
  printf "%s?%s %s\n" "$B" "$N" "$question" >&2
  asked=$(( (${#question} + 2 + COLUMNS_TTY - 1) / COLUMNS_TTY )) # the lines it took, wrapped
  while :; do
    [ "$top" -le "$sel" ] || top=$sel
    [ "$top" -gt $(( sel - height )) ] || top=$(( sel - height + 1 ))
    [ "$top" -ge 1 ] || top=1
    [ "$top" -le $(( lines - height + 1 )) ] || top=$(( lines - height + 1 ))
    [ "$drawn" -eq 0 ] || printf '\e[%dA' "$drawn" >&2
    drawn=$(( height + 1 ))
    [ -z "$MENU_HEADER" ] || { printf '   %.*s\e[K\n' "$width" "$MENU_HEADER" >&2; drawn=$((drawn + 1)); }
    for (( i = top; i < top + height; i++ )); do
      line=$(printf '%.*s' "$width" "${MENU_LINES[i-1]}")
      if [ "$i" -eq "$sel" ]; then printf '%s > %s%s\e[K\n' "$hl" "$line" "$off" >&2
      elif menu_ok "$i"; then printf '   %s\e[K\n' "$line" >&2
      else printf '   %s%s%s\e[K\n' "$D" "$line" "$N" >&2; fi
    done
    line=$(printf '%s↑↓ move · enter picks · q cancels (%d/%d)' "${MENU_HINT:+$MENU_HINT · }" "$sel" "$lines")
    printf '  %s%.*s%s\e[K\n' "$D" "$width" "$line" "$N" >&2
    step=0
    IFS= read -rsn1 key || return 1
    case $key in
      '') break ;; # enter
      $'\e') read -rsn2 esc
             case $esc in
               '[A') step=-1 ;;
               '[B') step=1 ;;
               '[5') read -rsn1 _; step=-$height ;;
               '[6') read -rsn1 _; step=$height ;;
             esac ;;
      k) step=-1 ;;
      j) step=1 ;;
      q | $'\x04') return 1 ;; # ^D is a key here, not an end of input: a raw read never sees one
    esac
    [ "$step" -ne 0 ] || continue
    dir=1; [ "$step" -gt 0 ] || dir=-1
    i=$(( sel + step ))
    [ "$i" -ge 1 ] || i=1
    [ "$i" -le "$lines" ] || i=$lines
    while [ "$i" -ge 1 ] && [ "$i" -le "$lines" ] && ! menu_ok "$i"; do i=$(( i + dir )); done
    [ "$i" -ge 1 ] && [ "$i" -le "$lines" ] && sel=$i # nothing that way: stay where we are
  done
  # The answer replaces the window, so a run of questions reads as what was asked and answered
  printf '\e[%dA\e[J  %s: %s\n' "$(( drawn + asked ))" "$question" "${MENU_LINES[sel-1]# }" >&2
  printf '%s\n' "$sel"
}
yes_no() { # yes_no <question>: true for yes; no unless picked (or typed: y, yes), cancelling included
  local MENU_VALUES=(no yes) MENU_LINES=(' no' ' yes') answer
  answer=$(menu "$1" no) || return 1
  case $answer in y | Y | yes) return 0 ;; *) return 1 ;; esac
}
menu_list() { # menu_list <lines>: MENU_VALUES and MENU_LINES from "<value> <description>" lines
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    MENU_VALUES[${#MENU_VALUES[@]}]=${line%% *}
    MENU_LINES[${#MENU_LINES[@]}]=" $line"
  done <<< "$1"
}

# --- configuration: node-ctl.yaml (see docs/adr/0017) --------------------------------------------
# The file is read once into CONFIG as JSON, so jq answers every lookup. The scripts and the
# Terraform providers keep reading the environment: load_config exports the Tailscale and restic
# values under their usual names, and the credentials of one cloud account are set per call
# (hc, cb, tf_account), because there is one set per account.

CONFIG='{}'
cfg() { jq -r "$@" <<< "$CONFIG"; } # cfg [jq options] <filter>: a value of node-ctl.yaml
load_config() {
  if [ -f "$CONFIG_FILE" ]; then
    command -v yq >/dev/null || die "yq is not installed, and $CONFIG_FILE needs it (brew install yq)"
    CONFIG=$(yq -o=json '. // {}' "$CONFIG_FILE") || die "$CONFIG_FILE is not valid YAML"
  fi
  eval "$(cfg '
    "export TAILSCALE_OAUTH_CLIENT_ID=\(.tailscale.client_id // "" | @sh)",
    "export TAILSCALE_OAUTH_CLIENT_SECRET=\(.tailscale.client_secret // "" | @sh)",
    "export RESTIC_REPOSITORY=\(.restic.repository // "" | @sh)",
    "export RESTIC_PASSWORD=\(.restic.password // "" | @sh)",
    "export AWS_ACCESS_KEY_ID=\(.restic.access_key_id // "" | @sh)",
    "export AWS_SECRET_ACCESS_KEY=\(.restic.secret_access_key // "" | @sh)",
    "SSH_PUBLIC_KEY_FILE=\(.ssh_public_key_file // "~/.ssh/id_ed25519.pub" | @sh)"')"
  SSH_PUBLIC_KEY_FILE=${SSH_PUBLIC_KEY_FILE/#\~/$HOME}
}
cfg_set() { # cfg_set <yq path> <value>: one value into node-ctl.yaml, its comments kept; the example seeds a missing file
  [ -f "$CONFIG_FILE" ] || cp node-ctl.example.yaml "$CONFIG_FILE" || return 1
  V=$2 yq -i "$1 = strenv(V)" "$CONFIG_FILE" && load_config
}

# Accounts: a tag of the user's choice for one cloud account, under .hetzner (an API token) or
# .contabo (an OAuth client and an API user) in the config. A machine belongs to one (.account in
# its inventory), and everything that talks to that cloud runs with its credentials. A tag names
# exactly one account, so it also says which provider the machine lives on (ADR-0018).
accounts() { cfg '[(.hetzner // {} | keys), (.contabo // {} | keys)] | add // [] | .[]'; }
account_labels() { cfg '. as $c | ("hetzner", "contabo") | . as $p | ($c[$p] // {} | keys[]) | "\($p)/\(.)"'; }
providers_of_tag() { cfg --arg t "$1" '. as $c | ("hetzner", "contabo") | select(($c[.] // {}) | has($t))'; }
provider_of_tag() { providers_of_tag "$1" | head -1; } # hetzner | contabo; empty for an unknown tag
provider_of() { provider_of_tag "$(account_of "$1")"; } # provider_of <name>
token_of() { cfg --arg t "$1" '.hetzner[$t] // empty'; }
account_of() { get "$1" '.account // empty'; }
default_type() { case $1 in contabo) cfg '.defaults.contabo.type // "V45"' ;; *) cfg '.defaults.type // "cx23"' ;; esac; }
default_location() { case $1 in contabo) cfg '.defaults.contabo.location // "EU"' ;; *) cfg '.defaults.location // "nbg1"' ;; esac; }
ensure_account() { # ensure_account <name>: the machine's account is in the config; before the first action, since the lookups run inside $(...)
  local tag n
  tag=$(account_of "$1")
  [ -n "$tag" ] || die "$1 has no account: add \"account\": \"<tag>\" to $SERVERS/$1.json (tags in $CONFIG_FILE: $(accounts | paste -s -d ' ' -))"
  n=$(providers_of_tag "$tag" | grep -c .) || true
  [ "$n" -ne 0 ] || die "no account $tag in $CONFIG_FILE, which $1 belongs to; ./node-ctl init"
  [ "$n" -eq 1 ] || die "the tag $tag names a Hetzner and a Contabo account in $CONFIG_FILE; a tag must name one"
}
ensure_accounts() { local f; for f in "$SERVERS"/*.json; do f=${f##*/}; ensure_account "${f%.json}"; done; }
hc_tag() { HCLOUD_TOKEN=$(token_of "$1") "${@:2}"; } # hc_tag <tag> <command ...>: with that account's Hetzner token, for a machine that has no inventory entry yet
hc() { hc_tag "$(account_of "$1")" "${@:2}"; } # hc <name> <command ...>: the command runs with the machine's Hetzner token
cb() { # cb <tag> <command ...>: the command runs with that Contabo account's credentials, under the
  # names the Terraform provider and scripts/contabo.sh read; a subshell keeps the exports local.
  ( export CNTB_OAUTH2_CLIENT_ID CNTB_OAUTH2_CLIENT_SECRET CNTB_OAUTH2_USER CNTB_OAUTH2_PASS
    eval "$(contabo_creds "$1" CNTB_OAUTH2_CLIENT_ID CNTB_OAUTH2_CLIENT_SECRET CNTB_OAUTH2_USER CNTB_OAUTH2_PASS)"
    "${@:2}" )
}
contabo_creds() { # contabo_creds <tag> <id var> <secret var> <user var> <password var>: the account's four values as assignments to eval
  cfg --arg t "$1" --arg a "$2" --arg b "$3" --arg c "$4" --arg d "$5" '.contabo[$t] // {}
    | "\($a)=\(.client_id // "" | @sh) \($b)=\(.client_secret // "" | @sh) \($c)=\(.user // "" | @sh) \($d)=\(.password // "" | @sh)"'
}

pick_account() { # pick_account [tag]: the account of a new machine on stdout; asked on a terminal when there are several
  local tags n tag MENU_VALUES=() MENU_LINES=()
  tags=$(accounts)
  n=$(printf '%s' "$tags" | grep -c .) || true
  [ "$n" -gt 0 ] || die "no cloud account in $CONFIG_FILE: ./node-ctl init hetzner, or ./node-ctl init contabo"
  if [ -n "$1" ]; then
    [ -n "$(provider_of_tag "$1")" ] || die "no account $1 in $CONFIG_FILE (tags: $(paste -s -d ' ' - <<< "$tags"))"
    echo "$1"; return
  fi
  [ "$n" -gt 1 ] || { echo "$tags"; return; }
  [ -t 0 ] || die "several accounts ($(account_labels | paste -s -d ' ' -)): pass --account <tag>"
  menu_list "$(while IFS= read -r tag; do echo "$tag ($(provider_of_tag "$tag"))"; done <<< "$tags")"
  tag=$(menu account) || die "aborted"
  grep -qxF -- "$tag" <<< "$tags" || die "not an account: $tag"
  echo "$tag"
}

# --- terraform: the host binary, state local to the root, one workspace per account (ADR-0015, ADR-0017)

export TF_IN_AUTOMATION=1
tf() { TF_VAR_ssh_public_key=$(cat "$SSH_PUBLIC_KEY_FILE") terraform -chdir="$1" "${@:2}"; } # tf <root dir> <args ...>
# One root per provider: the Contabo provider asks its API for a token as soon as it is configured,
# so it cannot sit in a configuration an apply of a Hetzner account also loads (ADR-0018).
# Providers cannot be created in a loop, so every account is its own workspace (state under
# <root>/terraform.tfstate.d/<tag>) and the configuration only sees that account's machines.
tf_account() { # tf_account <tag> <args ...>
  case $(provider_of_tag "$1") in
    contabo) cb "$1" env TF_WORKSPACE="$1" TF_VAR_account="$1" TF_VAR_ssh_public_key="$(cat "$SSH_PUBLIC_KEY_FILE")" \
      terraform -chdir=terraform/contabo "${@:2}" ;;
    *) HCLOUD_TOKEN=$(token_of "$1") TF_WORKSPACE=$1 TF_VAR_account=$1 tf terraform "${@:2}" ;;
  esac
}

do_apply() {
  local tag
  with_action "terraform init" init action_run tf terraform init -input=false -no-color || return 1
  [ -z "$(cfg '.contabo // {} | keys[]')" ] \
    || with_action "terraform init (contabo)" init action_run tf terraform/contabo init -input=false -no-color || return 1
  for tag in $(accounts); do
    if [ "$(provider_of_tag "$tag")" = contabo ]; then contabo_instances_first "$tag" || return 1; fi
    with_action "terraform apply ($tag)" apply action_run tf_account "$tag" apply -input=false -no-color -auto-approve || return 1
  done
}
# Contabo refuses a firewall (402) until its instance has finished provisioning, and the provider
# leaves the firewall it created behind, so the next apply fails on the name (409). A machine whose
# firewall Terraform does not hold yet gets its instance on its own first, then its firewall in the
# full apply once Contabo reports the instance up; machines that have one cost nothing extra.
contabo_instances_first() { # contabo_instances_first <tag>
  local tag=$1 f name have targets=() waits=''
  have=$(tf_account "$tag" state list 2>/dev/null) || have=''
  for f in "$SERVERS"/*.json; do
    name=${f##*/} && name=${name%.json}
    jq -e --arg t "$tag" '.account == $t and .state != "archived"' "$f" >/dev/null || continue
    ! grep -qxF "contabo_firewall.dev[\"$name\"]" <<< "$have" || continue
    targets[${#targets[@]}]="-target=contabo_instance.dev[\"$name\"]"
    waits="$waits $name"
  done
  [ -n "$waits" ] || return 0
  with_action "terraform apply ($tag, instances)" apply \
    action_run tf_account "$tag" apply -input=false -no-color -auto-approve "${targets[@]}" || return 1
  for name in $waits; do
    with_action "Wait for the $name instance" wait action_run cb "$tag" scripts/contabo.sh wait "$name" || return 1
  done
}
apply() {
  ensure_accounts # a machine of an unknown account is in no workspace, and no apply would ever see it
  with_action "Apply Terraform" apply do_apply \
    || die "terraform apply failed: the inventory is updated, the infrastructure is not; fix the cause, then: ${1:-./node-ctl apply}"
  local f
  for f in "$SERVERS"/*.json; do # a stopped machine's VPS is gone now: its stop is over
    if [ "$(jq '.state != "running" and .stopping != null' "$f")" = true ]; then f=${f##*/}; edit "${f%.json}" 'del(.stopping)'; fi
  done
  update_ssh_config # machines that went away are gone from ~/.ssh/config.d/node-ctl here; new ones get their address in wait_ready
}
tf_machines() { # the addresses Terraform knows, every account merged: {name: {ipv4, ipv6}}
  local tag
  for tag in $(accounts); do tf_account "$tag" output -json 2>/dev/null || true; done | jq -s 'map(.machines.value // {}) | add // {}'
}

# --- inventory: servers/<name>.json -----------------------------------------------------------

exists() { [ -f "$SERVERS/$1.json" ] || die "no such machine: $1"; ensure_account "$1"; }
get() { # get <name> [jq options] <filter>
  local f=$SERVERS/$1.json
  shift
  jq -r "$@" "$f"
}
edit() { # edit <name> [jq options] <filter>
  local f=$SERVERS/$1.json
  shift
  jq "$@" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
}

ports_json() { # ports_json [port ...] -> "22,80"
  local p
  for p in "$@"; do [[ $p =~ ^[0-9]+$ ]] || die "not a port: $p"; done
  printf '%s\n' 22 "$@" | sort -un | paste -s -d , -
}

machines_in() { # machines_in <state>: the names of the machines in that state, one per line
  local files=("$SERVERS"/*.json)
  [ ${#files[@]} -eq 0 ] || jq -r --arg s "$1" '
    select(.state == $s) | input_filename | sub(".*/"; "") | sub("\\.json$"; "")' "${files[@]}"
}
running_machines() { machines_in running; }
pick_machine() { # pick_machine "[state ...]" [all]: the machine picked on the terminal, of those states (any without one); its name on stdout
  # With <all>, the first line is "--all" for every one of them, described by <all>.
  local files=("$SERVERS"/*.json) lines name MENU_VALUES=() MENU_LINES=()
  [ ${#files[@]} -eq 0 ] || lines=$(jq -r --arg s " $1 " '
    .state as $st | select($s == "  " or ($s | contains(" \($st) ")))
    | [(input_filename | sub(".*/"; "") | sub("\\.json$"; "")), .state, .type, .location, .account] | @tsv' "${files[@]}" | column -t)
  [ -n "${lines:-}" ] || die "no ${1:+$1 }machine for $cmd; ./node-ctl list"
  menu_list "$lines"
  [ -z "${2:-}" ] || { MENU_VALUES=(--all "${MENU_VALUES[@]}") MENU_LINES=(" all: $2" "${MENU_LINES[@]}"); }
  name=$(menu machine) || die "aborted"
  printf '%s\n' "${MENU_VALUES[@]}" | grep -qxF -- "$name" || die "not a machine: $name"
  echo "$name"
}

# --- remote helpers (over the tailnet) --------------------------------------------------------

# Every ssh goes over the tailnet, where WireGuard already authenticates the peer, and a rebuilt
# machine (stop/start, restore) gets a fresh host key under the same name: host keys are neither
# needed nor stable, so they are not checked or recorded. Without this, BatchMode refuses every
# new machine ("Host key verification failed") and create never becomes ready.
tssh() { ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$@"; }
tailscale_cli() { # the CLI, wherever this host keeps it; nothing when Tailscale is not installed
  local cli
  for cli in tailscale /Applications/Tailscale.app/Contents/MacOS/Tailscale; do command -v "$cli" && return; done
  return 1
}
addr() { # a machine's tailnet address: the local daemon knows it even while MagicDNS answers nothing (tailscale/tailscale#19139)
  local cli
  cli=$(tailscale_cli) && "$cli" ip -4 "$1" 2>/dev/null && return
  echo "$1"
}
ensure_tailscale() { # with the tailnet off every ssh hangs or fails on a bare name; say so before anything runs
  local cli
  cli=$(tailscale_cli) || return 0 # no CLI: MagicDNS is all there is, ssh reports the rest
  "$cli" status >/dev/null 2>&1 || die "Tailscale is not running on this computer; turn it on, then retry ($cli up)"
}
tailnet_suffix() { # the MagicDNS suffix of this host's tailnet, e.g. tailXXXX.ts.net; empty without the CLI
  local cli
  cli=$(tailscale_cli) || return 0
  "$cli" status --json 2>/dev/null | sed -n 's/.*"MagicDNSSuffix": *"\([^"]*\)".*/\1/p' | head -1
}

# --- ~/.ssh/config.d/node-ctl: plain `ssh node-ctl-<name>` for every running machine -------------------------

# Regenerated whenever the set of machines or their addresses can have changed, so it carries the
# resolved tailnet address (MagicDNS may answer nothing on the host) and the same host-key stance
# as tssh. Hosts carry a `node-ctl-` prefix so they never shadow entries in the user's own config.
# Generated, never merged: a machine edited out of the inventory is gone from here too.
write_ssh_config() {
  local name running
  running=$(running_machines) || return 1
  mkdir -p "$(dirname "$SSH_CONFIG")" || return 1
  {
    echo "# Generated by ./node-ctl — edits are overwritten. Machines: ./node-ctl list"
    for name in $running; do
      printf '\nHost node-ctl-%s\n  HostName %s\n  User node-ctl-user\n  StrictHostKeyChecking no\n  UserKnownHostsFile /dev/null\n' \
        "$name" "$(addr "$name")"
    done
  } > "$SSH_CONFIG.tmp" && mv "$SSH_CONFIG.tmp" "$SSH_CONFIG"
}
update_ssh_config() { write_ssh_config || warn "could not write $SSH_CONFIG; ./node-ctl ssh still works"; }

# --- host-key stores: the keys of a machine that was just rebuilt -------------------------------

# ./node-ctl never checks a host key (see tssh), but everything else on this computer does: a
# rebuilt machine answers under the same names with a new key, and scp, rsync, git or an editor's
# remote session stops at "REMOTE HOST IDENTIFICATION HAS CHANGED" until someone clears the entry
# by hand. So whenever a machine becomes ready, its old entries go and the keys it answers with now
# take their place.
known_hosts_names() { # the names it answers under: its tailnet address, its name, its MagicDNS name
  local ip suffix
  ip=$(addr "$1")
  echo "$ip"
  [ "$ip" = "$1" ] || echo "$1"
  suffix=$(tailnet_suffix)
  [ -z "$suffix" ] || echo "$1.$suffix"
}
refresh_known_hosts() { # <name>: replace the machine's entries with the keys it offers now
  local file=$SSH_DIR/known_hosts host keys got='' # ponytail: the default file; a UserKnownHostsFile of your own stays yours
  mkdir -p "$SSH_DIR" && touch "$file" || return 1
  for host in $(known_hosts_names "$1"); do
    # The stale entry goes even when nothing answers under that name: a name MagicDNS does not
    # resolve on this host (tailscale/tailscale#19139) has no key to record, but its old one lies.
    ssh-keygen -q -R "$host" -f "$file" >/dev/null 2>&1 # a name that was never there is not an error
    keys=$(ssh-keyscan -T 10 "$host" 2>/dev/null) || keys=''
    update_orca_key "$host" "$keys"
    [ -n "$keys" ] || continue
    printf '%s\n' "$keys" >> "$file" || return 1
    got=1
  done
  [ -n "$got" ]
}

# Orca ADE keeps host keys in its own JSON store, one per profile, and refuses a machine whose key
# changed with "remove its entry ... and reconnect": ~/.ssh/known_hosts does not reach it, so a
# rebuild locks the IDE out until someone edits that file by hand. It gets the same treatment, and
# nothing when Orca is not installed. A store that is not valid JSON is left exactly as it is.
ORCA_PROFILES=${ORCA_PROFILES:-$HOME/Library/Application Support/orca/profiles}
orca_stores() { # the host-key file of every Orca profile on this computer, one per line
  local f
  for f in "$ORCA_PROFILES"/*/ssh-host-keys.json; do [ ! -f "$f" ] || echo "$f"; done
}
orca_entry() { # orca_entry <host> <ssh-keyscan lines>: the ed25519 key as an accepted entry of the store
  local line fp
  line=$(printf '%s\n' "$2" | grep '^[^ ]* ssh-ed25519 ' | head -1)
  [ -n "$line" ] || return 1 # only ed25519: it is what the machines offer and what the store holds
  fp=$(printf '%s\n' "$line" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
  [ -n "$fp" ] || return 1
  jq -nc --arg host "$1" --arg key "${line##* }" --arg fp "$fp" \
    '{host: $host, port: 22, keyType: "ssh-ed25519", key: $key, fingerprint: $fp, acceptedAt: (now | todate)}'
}
update_orca_key() { # update_orca_key <host> [ssh-keyscan lines]: record the key it offers now, or just drop the stale one
  local store entry
  entry=$(orca_entry "$1" "${2:-}") || entry=null
  while IFS= read -r store; do
    if jq --arg host "$1" --argjson add "$entry" \
      '.hostKeys = ((.hostKeys // []) | map(select(.host != $host)) + ([$add] | map(select(. != null))))' \
      "$store" > "$store.tmp" 2>/dev/null
    then mv "$store.tmp" "$store"
    else rm -f "$store.tmp"
    fi
  done < <(orca_stores)
}
update_known_hosts() { # never fatal: a missing entry only means ssh asks about the key once
  refresh_known_hosts "$1" || warn "could not record $1's host key in $SSH_DIR/known_hosts; ssh asks about it"
}

ensure_ssh_include() { # ~/.ssh/config pulls the generated file in, so `ssh node-ctl-dev1` works from anywhere
  local main=$SSH_DIR/config
  grep -qxF "$SSH_INCLUDE" "$main" 2>/dev/null && return 0
  mkdir -p "$SSH_DIR" || return 1
  # First on purpose: in ssh_config the first value of a keyword wins, so a later `Host *` block in
  # the user's own config cannot override what the generated entries set.
  { echo "$SSH_INCLUDE"; echo; [ ! -f "$main" ] || cat "$main"; } > "$main.tmp" \
    && mv "$main.tmp" "$main" && info "added '$SSH_INCLUDE' to $main"
}

ts_logout() { # free the hostname in the tailnet before the VPS goes away
  # The session itself rides the tailnet: a logout run inline kills the tunnel under ssh, which then
  # waits out the TCP timeout (~30 min on macOS). A 2 s transient timer lets ssh disconnect first.
  # action_run, not a bare tssh: an unreachable machine makes ssh print its own error, and a line
  # that reaches the terminal beside the renderer shifts the cursor under the live region, which
  # then redraws one row too low and leaves the frame it was erasing behind.
  action_run tssh -o ConnectTimeout=10 -o BatchMode=yes "node-ctl-user@$(addr "$1")" sudo systemd-run --quiet --on-active=2 tailscale logout && return
  warn "could not log $1 out of Tailscale; deleting its node through the API"
  with_action "tailscale-rm.sh $1" api action_run scripts/tailscale-rm.sh "$1" \
    || warn "could not delete the node either; remove $1 in the admin console"
}
leave_tailnet() { with_action "Leave the tailnet" logout ts_logout "$1"; }

# ts_logout's own removal is a best-effort background timer racing the destroy that follows it
# (see above): a lost race leaves a stale node that steals $1 on the next create, silently renaming
# the new machine to "$1-1" and stranding ./node-ctl's polling on the dead old address. Idempotent: a
# clean tailnet has nothing to delete here.
free_tailnet_name() { with_action "Free the tailnet name" api action_run scripts/tailscale-rm.sh "$1"; }

wait_loop() { # ssh over the tailnet answers and cloud-init has finished
  local rc err i
  for i in $(seq 1 60); do
    rc=0
    err=$(tssh -o ConnectTimeout=5 -o BatchMode=yes "node-ctl-user@$(addr "$1")" 'sudo cloud-init status --wait >/dev/null' 2>&1 >/dev/null) || rc=$?
    case $rc in
      0) return ;;
      2) warn "cloud-init finished with recoverable errors on $1"; return ;;
      255) action_progress "$i" 60 "${err:-no answer yet}"; sleep 10 ;;
      *)
        # Contabo merges its own cloud-config into ours: a chpasswd for its default user admin, whom
        # our users list replaces, so that one step fails on every Contabo machine and nothing else does.
        if tssh -o ConnectTimeout=5 -o BatchMode=yes "node-ctl-user@$(addr "$1")" 'sudo cloud-init status --format json || true' 2>/dev/null \
          | jq -e '.errors | length > 0 and all(.[]; test("^[(].set_passwords."))' >/dev/null; then
          warn "cloud-init on $1 failed only to set a password for the provider's admin user, which node-ctl-user replaces"
          return
        fi
        die "cloud-init failed on $1; see: ./node-ctl ssh $1 cat /var/log/cloud-init-output.log" ;;
    esac
  done
  die "$1 is not reachable over the tailnet: ${err:-no answer}
  (Tailscale off or MagicDNS not answering on this host? ./node-ctl check tells; the machine's public address is in ./node-ctl list)"
}
# only now does the tailnet know the address; a rebuilt machine also gets its Funnel back
wait_ready() { with_action "Wait for $1" ready wait_loop "$1" && update_ssh_config && update_known_hosts "$1" && install_git_key "$1" && install_agent_files "$1" && restore_funnel "$1"; }

remote() { tssh "node-ctl-user@$(addr "$1")" sudo bash -s; } # script on stdin: secrets never touch a command line

# One commit key for all machines: git on a disposable machine pushes as this key, so nothing on it
# has to be set up (or salvaged) per machine. The private half rides inside the piped script, like
# restic's credentials. The home rides the disk snapshot, so a restart finds the key already there;
# writing it every time is what makes a rotated key reach existing machines.
push_git_key() {
  remote "$1" <<EOF
set -euo pipefail
install -d -m 700 -o node-ctl-user -g node-ctl-user ~node-ctl-user/.ssh
touch ~node-ctl-user/.ssh/id_ed25519
chmod 600 ~node-ctl-user/.ssh/id_ed25519
cat > ~node-ctl-user/.ssh/id_ed25519 <<'KEY'
$(cat "$GIT_KEY_FILE")
KEY
# an unknown host key must not stop a git clone on a machine nobody is watching
grep -qs accept-new ~node-ctl-user/.ssh/config ||
  printf 'Host *\n\tStrictHostKeyChecking accept-new\n' >> ~node-ctl-user/.ssh/config
chmod 600 ~node-ctl-user/.ssh/config
chown node-ctl-user:node-ctl-user ~node-ctl-user/.ssh/id_ed25519 ~node-ctl-user/.ssh/config
EOF
}
install_git_key() {
  [ -f "$GIT_KEY_FILE" ] || { warn "no $GIT_KEY_FILE: git on $1 has no commit key (./node-ctl init gitkey)"; return 0; }
  with_action "Install the git key" gitkey action_run push_git_key "$1"
}

# The agent on a machine works under this computer's own instructions, skills and MCP servers. They ride
# the disk snapshot, so writing them on every start (and apply) is what makes an edit here reach a machine
# that already exists. Skills and servers are merged over the machine's own: what the agent there added stays.
CLAUDE_DIR=${CLAUDE_DIR:-$HOME/.claude}
AGENT_FILES=(CLAUDE.md AGENTS.md)
agent_files_script() { # one script for every file that exists here; nothing at all when none does
  local f
  for f in "${AGENT_FILES[@]}"; do
    [ -f "$CLAUDE_DIR/$f" ] || continue
    cat <<EOF
install -d -m 755 -o node-ctl-user -g node-ctl-user ~node-ctl-user/.claude
cat > ~node-ctl-user/.claude/$f <<'AGENTFILE'
$(cat "$CLAUDE_DIR/$f")
AGENTFILE
chown node-ctl-user:node-ctl-user ~node-ctl-user/.claude/$f
EOF
  done
}
CLAUDE_JSON=${CLAUDE_JSON:-$HOME/.claude.json}
mcp_script() { # adds the user-scope MCP servers here (tokens included) that the machine's ~/.claude.json lacks: one edited there wins; node is there for codex
  local servers
  servers=$(jq -c '.mcpServers // {}' "$CLAUDE_JSON" 2>/dev/null) || return 0
  [ "$servers" != '{}' ] || return 0
  cat <<EOF
sudo -u node-ctl-user -H node - <<'MCPJS'
const fs = require('fs'), f = require('os').homedir() + '/.claude.json'
const c = fs.existsSync(f) ? JSON.parse(fs.readFileSync(f, 'utf8')) : {}
c.mcpServers = { ...$servers, ...c.mcpServers }
fs.writeFileSync(f, JSON.stringify(c, null, 2), { mode: 0o600 })
MCPJS
EOF
}
skill_names() { # the skills to push: node-ctl-migrate drives this computer's node-ctl, a dangling link has nothing to send
  local s
  for s in "$SKILLS_DIR"/*; do
    if [ -e "$s" ] && [ "${s##*/}" != node-ctl-migrate ]; then echo "${s##*/}"; fi
  done
}
# Links followed: skills here are often links into a checkout. On the machine they land in ~/.claude/node-ctl-skills,
# replaced whole, and ~/.claude/skills links to each: a link into it is ours, so a skill (or a file of one) deleted
# here goes there too, and the agent's own skills are never touched; one of the same name wins over ours.
# ponytail: the whole tree on every sync; rsync if it grows
push_skills() {
  skill_names | COPYFILE_DISABLE=1 tar -czhf - --no-xattrs --exclude .DS_Store -C "$SKILLS_DIR" -T - \
    | tssh "node-ctl-user@$(addr "$1")" 'set -e; cd ~/.claude && rm -rf node-ctl-skills && mkdir -p node-ctl-skills skills
      tar -xzf - -C node-ctl-skills --warning=no-unknown-keyword && cd skills
      for s in *; do [ ! -L "$s" ] || case $(readlink "$s") in ../node-ctl-skills/*) rm "$s" ;; esac; done
      for s in ../node-ctl-skills/*; do [ ! -e "$s" ] || [ -e "${s##*/}" ] || [ -L "${s##*/}" ] || ln -s "$s" .; done'
}
sync_agent() {
  local script=$2
  { [ -z "$script" ] || action_run remote "$1" <<< "set -euo pipefail
$script"; } && { [ ! -d "$SKILLS_DIR" ] || action_run push_skills "$1"; }
}
install_agent_files() {
  local script
  script=$(agent_files_script; mcp_script)
  [ -n "$script" ] || [ -d "$SKILLS_DIR" ] || return 0
  with_action "Sync the agent setup to $1" agentmd sync_agent "$1" "$script"
}

ensure_key() { # the private key sits in ssh-agent, so BatchMode ssh calls never need the passphrase
  local key=${SSH_PUBLIC_KEY_FILE%.pub} rc=0
  [ -f "$key" ] || return 0 # only the public half is here: ssh will find the private key elsewhere
  ssh-add -L 2>/dev/null | grep -qF "$(cut -d' ' -f1,2 "$SSH_PUBLIC_KEY_FILE")" && return 0
  ssh-add -l >/dev/null 2>&1 || rc=$?
  [ $rc -ne 2 ] || { warn "no ssh-agent running; start one with: eval \$(ssh-agent)"; return 0; }
  info "loading $key into ssh-agent (asked once; macOS keeps the passphrase in Keychain)"
  if [ "$(uname)" = Darwin ]; then ssh-add --apple-use-keychain "$key"; else ssh-add "$key"; fi
}

# restic and the machines read these names; load_config fills them from .restic in the config. Optional: archives off when empty.
RESTIC_VARS=(RESTIC_REPOSITORY RESTIC_PASSWORD AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY)
RESTIC_KEYS=(restic.repository restic.password restic.access_key_id restic.secret_access_key) # the same, as config paths

require_restic() {
  local i v
  for i in 0 1 2 3; do
    v=${RESTIC_VARS[i]}
    [ -n "${!v:-}" ] || die "${RESTIC_KEYS[i]} is not set in $CONFIG_FILE: archives need an S3 bucket, run ./node-ctl init restic"
  done
}
restic_exports() {
  local v
  for v in "${RESTIC_VARS[@]}"; do
    printf 'export %s=%q\n' "$v" "${!v}"
  done
}

backup() {
  remote "$1" <<EOF
set -euo pipefail
$(restic_exports)
restic cat config >/dev/null 2>&1 || restic init
systemctl stop docker.socket docker
trap 'systemctl start docker' EXIT
paths=/data; ! mountpoint -q /mnt/volume || paths="/data /mnt/volume"
restic backup \$paths --tag $1
EOF
}
snapshot() { with_action "Snapshot /data of $1" backup action_run backup "$1"; }

restore_data() { # restore_data <name> <restic selector>
  remote "$1" <<EOF
set -euo pipefail
$(restic_exports)
systemctl stop docker.socket docker
trap 'systemctl start docker' EXIT
restic restore $2 --target /
EOF
}

# --- the kept root disk: one Hetzner snapshot per machine --------------------------------------
# /data is on the root disk (ADR-0016), so the snapshot stop takes is the only copy of a stopped
# machine and a rollback point of a running one. stop records the new image in the inventory and
# only then deletes the older ones (scripts/image.sh prune): once a machine has a snapshot it is
# never without one, and it never has two for long.
hcloud_image() { hc "$2" scripts/image.sh "$@"; } # hcloud_image <create|prune|disk> <name> ...

keep_image() { # power the machine off, snapshot its disk, write the image id to the inventory, drop the previous one
  local id
  # The id comes back on stdout, so only the script's own stderr can be tagged as the action's log.
  id=$(hcloud_image create "$1" 2> >(tag "${ACTIONS##* }" stderr)) || id=''
  [ -n "$id" ] || { FAIL_MESSAGE="could not snapshot the root disk of $1"; return 1; }
  edit "$1" --arg i "$id" '.image = $i' || return 1
  action_log "root disk kept as image $id"
  action_run hcloud_image prune "$1" "$id" || warn "could not delete the previous snapshot of $1; delete it in the Hetzner console"
}
snapshot_disk() { with_action "Snapshot the root disk" image keep_image "$1"; }

prune_images() { # prune_images <name>: nothing of a destroyed or archived machine stays billed
  with_action "Delete the root disk snapshot" image action_run hcloud_image prune "$1" \
    || warn "could not delete the snapshot of $1; delete it in the Hetzner console"
}

# Contabo has no disk snapshot and no VPS to delete for free: an instance is a monthly contract, so
# stop and start are power actions on the API and the disk simply stays where it is (ADR-0018).
contabo_power() { cb "$(account_of "$1")" scripts/contabo.sh power "$2" "$1"; }
power_off() { with_action "Power off" power action_run contabo_power "$1" off; }
power_on() { with_action "Power on" power action_run contabo_power "$1" on; }

# Tailscale Funnel publishes a port of the machine on the internet as https://<name>.<tailnet>.ts.net.
# Its configuration lives in tailscaled's state on the root disk, which stop + start throws away,
# so the inventory (.funnel: path -> port) is the source of truth and is replayed whole.
funnel_script() {
  echo 'set -euo pipefail'
  echo 'tailscale funnel reset'
  get "$1" '.funnel // {} | to_entries[] | "tailscale funnel --bg --set-path \(.key) \(.value)"'
}
push_funnel() { funnel_script "$1" | remote "$1"; }
update_funnel() { with_action "Configure Tailscale Funnel" funnel action_run push_funnel "$1"; }
restore_funnel() { [ "$(get "$1" '.funnel // {} | length')" = 0 ] || update_funnel "$1"; }

# --- commands ---------------------------------------------------------------------------------

# The aligned table `list` and `accounts` print: rows of strings in, header bold, a rule under it.
# The last column is never padded, so a trailing empty cell leaves no trailing spaces.
JQ_TABLE='
  def pad($w): . + ((" " * ($w - length)) // "");
  def cells($w): (length - 1) as $last | [range(length) as $i | .[$i] | if $i == $last then . else pad($w[$i]) end];
  def table: (transpose | map(map(length) | max)) as $w
    | ($w | add + 2 * (length - 1)) as $width
    | (.[0] | cells($w) | $b + join("  ") + $n),
      ($d + ("─" * $width) + $n),
      (.[1:][] | cells($w) | join("  "));
'


write_inventory() { # write_inventory <file> <account> <type> <location> <volume GB, 0 = none> <ports csv> [image]
  jq -n --arg a "$2" --arg t "$3" --arg l "$4" --argjson v "$5" --argjson p "[$6]" --arg i "${7:-}" \
    '{state: "running", started: (now | floor), account: $a, type: $t, location: $l} + (if $v > 0 then {volume_size: $v} else {} end)
     + (if $i == "" then {} else {image: $i} end) + {open_ports: $p, funnel: {}}' \
    > "$1" && action_log "$1: $3 $4 ports $6$([ "$5" = 0 ] || echo " volume ${5}G"), account $2"
}

# A Hetzner Volume is an extra disk at /mnt/volume for data too big for the root disk and its
# snapshots; it follows the machine through stop and start. /data does not need one.
ask_volume_size() { # ask_volume_size -> GB on stdout, 0 for none: asked on a terminal, --size answers it anywhere else
  local size='' MENU_VALUES=() MENU_LINES=() MENU_ANY='another size: type it in GB'
  [ -t 0 ] || { echo 0; return; }
  if menu_driven; then # a typed answer would be a size, not a line number, so only a drawn menu offers a list
    MENU_VALUES=(0 10 20 50 100 200 500) MENU_LINES=(" none" " 10 GB" " 20 GB" " 50 GB" " 100 GB" " 200 GB" " 500 GB")
    size=$(menu "Hetzner Volume at /mnt/volume") || die "aborted"
  else
    read -r -p "Add a Hetzner Volume at /mnt/volume? Size in GB, empty for none: " size || true
  fi
  echo "${size:-0}"
}
ask_ports() { # ask_ports -> the public ports besides 22 on stdout: asked on a terminal, --ports answers it anywhere else
  local ports=''
  [ -t 0 ] || return 0
  read -r -p "Public TCP ports besides 22 (e.g. 80,443), empty for none: " ports || true
  echo "${ports//,/ }"
}
mount_volume() { remote "$1" < scripts/mount-volume.sh; }

# A new machine picks its type from the same table a resize scrolls, with the locations that will
# take one where the migration column sits; the location is asked next when there are several.
locations_of() { printf '%s\n' "$1" | awk -F'\t' -v t="$2" '$1 == t { print $7 }'; } # locations_of <rows> <type>
pick_create_type() { # pick_create_type <rows>: the chosen type on stdout, nothing when it is not one of them
  local TYPE_LAST=LOCATIONS TYPE_HINT='LOCATIONS = where one can be created now' type
  type=$(pick_type "$1" '') || return 1
  printf '%s\n' "$1" | cut -f1 | grep -xF -- "$type" || true
}
pick_from() { # pick_from <question> <lines> [any]: the value picked on stdout, the menu on stderr
  # A line is "<value> <description>"; one line is no question. "any" also takes an answer that is
  # not in the list, for a list that is only a shortcut and not the whole truth.
  local question=$1 lines=$2 answer MENU_VALUES=() MENU_LINES=() MENU_ANY=''
  [ "$(grep -c . <<< "$lines")" -gt 1 ] || { awk 'NR == 1 { print $1 }' <<< "$lines"; return; }
  [ -z "${3:-}" ] || MENU_ANY="another $question: type it"
  menu_list "$lines"
  answer=$(menu "$question") || return 1
  [ -n "${3:-}" ] || awk '{ print $1 }' <<< "$lines" | grep -qxF -- "$answer" || return 0 # not one of them: nothing
  printf '%s\n' "$answer"
}

# Contabo has no catalogue endpoint and no prices in its API: the products are documented only by
# the table in createInstance's description, inside the public OpenAPI spec. That table is read on
# every create, so a new line-up needs no release here; it is a shortcut, not a whitelist: an id
# typed in full is taken as it is. The regions are documented by the Terraform provider itself
# (contabo/resource_instance.go: "Following regions are available").
contabo_regions() { printf '%s\n' EU US-central US-east US-west SIN; }
contabo_products() { # "<id> <product>, <disk>" per line
  curl -fsS "${CNTB_API:-https://api.contabo.com}/api-v1.yaml" \
    | yq '.paths."/v1/compute/instances".post.description' \
    | grep -oE '<tr><td>[^<]*</td><td>[^<]*</td><td>[^<]*</td></tr>' \
    | sed -E 's#<tr><td>([^<]*)</td><td>([^<]*)</td><td>([^<]*)</td></tr>#\1 \2, \3#'
}

cmd_create() {
  local name=
  case ${1:-} in
    "" | --*) # no name: a terminal asks it, like everything an option does not answer
      [ ! -t 0 ] || read -r -p "Name of the new machine: " name || die "aborted" ;;
    *) name=$1; shift ;;
  esac
  need "$name" "<name> [--account tag] [--type cx23] [--location nbg1] [--size GB] [--ports 22,80]"
  [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "name must be lowercase letters, digits and dashes"
  local f=$SERVERS/$name.json
  if [ -f "$f" ]; then
    [ $# -eq 0 ] || die "$name exists; options only apply to a new machine (edit $f and ./node-ctl apply, or ./node-ctl destroy $name first)"
    cmd_start "$name" # a machine that exists is started, whatever its provider does for that
    return
  else
    local account='' provider='' image='' type='' location='' size='' ports='' rows='' locs=''
    while [ $# -gt 0 ]; do
      case $1 in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
      [ $# -ge 2 ] || die "$1 needs a value"
      case $1 in
        --account) account=$2 ;;
        --type) type=$2 ;;
        --location) location=$2 ;;
        --size) size=$2 ;;
        --ports) ports=${2//,/ } ;;
        *) die "unknown option: $1" ;;
      esac
      shift 2
    done
    account=$(pick_account "$account")
    provider=$(provider_of_tag "$account")
    # The tariff, and then the location: asked on a terminal, where --type and --location answer it
    # for good; off one the defaults of node-ctl.yaml stand. Hetzner has a price list to read, so
    # its types come with what they cost and where one can be created, and only a type several
    # locations will take asks a second question. Contabo has neither prices nor a catalogue in its API
    # (ADR-0018): its menu is the line-up its API spec documents and every region.
    if [ -z "$type" ] && [ -t 0 ]; then
      if [ "$provider" = contabo ]; then
        rows=$(contabo_products) && [ -n "$rows" ] || die "could not read the products from Contabo's API spec; --type answers it"
        type=$(pick_from product "$rows" any) || die "aborted"
        [ -n "$location" ] || location=$(pick_from region "$(contabo_regions)" any) || die "aborted"
      else
        rows=$(hc_tag "$account" scripts/server-types.sh create) || die "could not read the server types from the Hetzner API"
        type=$(pick_create_type "$rows") || die "aborted"
        [ -n "$type" ] || die "not a type on offer"
        locs=$(locations_of "$rows" "$type")
        if [ -n "$location" ]; then
          grep -qxF "$location" <<< "${locs//,/$'\n'}" || die "$location cannot take a $type right now, only ${locs//,/, } can"
        else
          location=$(pick_from location "$(tr ',' '\n' <<< "$locs")") || die "aborted"
          [ -n "$location" ] || die "not a location that can take a $type"
        fi
      fi
    fi
    [ -n "$type" ] || type=$(default_type "$provider")
    [ -n "$location" ] || location=$(default_location "$provider")
    if [ "$provider" = contabo ]; then
      [ "${size:-0}" = 0 ] || die "a volume is Hetzner-only: Contabo has no block storage to attach (ADR-0018)"
      size=0
      # The standard image is a UUID there, and a changed one reinstalls the machine: it is looked
      # up once, here, and the inventory carries it from then on.
      image=$(cb "$account" scripts/contabo.sh image) || die "could not look up the Contabo image for $name; ./node-ctl check"
    else
      [ -n "$size" ] || size=$(ask_volume_size)
    fi
    [ -n "$ports" ] || ports=$(ask_ports)
    [[ $size =~ ^[0-9]+$ ]] || die "not a volume size in GB: $size"
    mkdir -p "$SERVERS"
    read -ra port_list <<< "$ports"
    local csv # validated before the first action: a die inside a with_action body cannot abort it
    csv=$(ports_json ${port_list[@]+"${port_list[@]}"}) # empty-array guard for bash 3.2
    plan "Free the tailnet name" "Write inventory" "Apply Terraform" "Wait for $name"
    free_tailnet_name "$name" || die "could not confirm $name is free on the tailnet; fix Tailscale API access, then retry"
    with_action "Write inventory" inventory write_inventory "$f" "$account" "$type" "$location" "$size" "$csv" "$image"
  fi
  apply
  wait_ready "$name"
  echo "ready: ./node-ctl ssh $name"
}

# A machine whose disk could not be kept stays in the inventory as it is: it is powered off, its
# volume and its disk are untouched, and the same command tries again from there.
stop_steps() { # stop_steps <name>: one machine, everything but the terraform apply the whole run shares
  # Its node leaves the tailnet first and the snapshot takes minutes: list would call it starting all
  # that time. This process is the mark, so a stop that dies leaves nothing list believes.
  edit "$1" --argjson p $$ '.stopping = $p'
  if [ "$(provider_of "$1")" = contabo ]; then
    # The instance stays (and stays billed): it is powered off, so its node keeps its place in the
    # tailnet and comes back with it. Nothing to log out of and nothing to snapshot (ADR-0018).
    power_off "$1" || return 1
  else
    leave_tailnet "$1" # while ssh still works: the snapshot then holds a tailscaled with no node
    snapshot_disk "$1" || return 1
  fi
  # The mark stays until the apply has deleted the VPS (apply drops it): a stop cut short there is
  # still unfinished, so stop and its autostop job run again instead of leaving a billed server behind.
  with_action "Write inventory" inventory edit "$1" '.state = "stopped"'
}
stop_plan() { # stop_plan <name> [step ...]: the steps stop_steps takes for that machine, then whatever follows
  local name=$1
  shift
  if [ "$(provider_of "$name")" = contabo ]; then plan "Power off" "Write inventory" "$@"
  else plan "Leave the tailnet" "Snapshot the root disk" "Write inventory" "$@"; fi
}
stop_failed() { # stop_failed <name>: why that machine is still running, in its provider's words
  if [ "$(provider_of "$1")" = contabo ]; then echo "could not power $1 off; retry: ./node-ctl stop $1"
  else echo "could not snapshot the root disk of $1; it is powered off and nothing is lost, retry: ./node-ctl stop $1"; fi
}

stop_one() { # stop_one <name>: stop_steps under its own action, for a run that stops several machines
  stop_plan "$1"
  stop_steps "$1" || { FAIL_MESSAGE=$(stop_failed "$1"); return 1; }
}

cmd_stop() { # --all stops every running machine; no name at all is a question (or a usage error), never all of them
  local name names=() failed='' steps=()
  if [ "${1:-}" = --all ]; then
    [ $# -eq 1 ] || die "--all takes no names"
    while IFS= read -r name; do ensure_account "$name"; names[${#names[@]}]=$name; done < <(running_machines)
    [ ${#names[@]} -gt 0 ] || die "no running machine to stop"
  else
    need "${1:-}" "<name ...> | --all"
    for name in "$@"; do
      exists "$name"
      [ "$(get "$name" .state)" = running ] || [ "$(get "$name" '.state == "stopped" and .stopping != null')" = true ] \
        || die "$name is not running"
      [ "$(get "$name" .state)" = stopped ] || names[${#names[@]}]=$name # one already stopped only needs the apply
    done
  fi
  if [ ${#names[@]} -eq 0 ]; then
    plan "Apply Terraform"
  elif [ ${#names[@]} -eq 1 ]; then
    stop_plan "${names[0]}" "Apply Terraform"
    stop_steps "${names[0]}" || die "$(stop_failed "${names[0]}")"
  else
    for name in "${names[@]}"; do steps[${#steps[@]}]="Stop $name"; done
    plan "${steps[@]}" "Apply Terraform"
    # One machine that cannot be snapshotted does not keep the others running: it stays in the
    # inventory as running, so the apply below leaves its VPS alone.
    for name in "${names[@]}"; do with_action "Stop $name" machine stop_one "$name" || failed="$failed $name"; done
  fi
  apply
  [ -z "$failed" ] || die "could not stop:$failed; they are still in the inventory as running and nothing is lost, retry: ./node-ctl stop$failed"
}

cmd_start() {
  local name names=() all='' type='' retype='' current location disk rows
  while [ $# -gt 0 ]; do
    case $1 in
      --type=*) retype=1 type=${1#*=} ;;
      --type) retype=1; case ${2:-} in '' | -*) ;; *) type=$2; shift ;; esac ;; # a bare --type asks
      --till=*) till_at "${1#*=}" ;;
      --till) till_at "${2:-}"; shift ;;
      --all) all=1 ;;
      -*) die "unknown option: $1" ;;
      *) names[${#names[@]}]=$1 ;;
    esac
    shift
  done
  if [ -n "$all" ]; then
    [ ${#names[@]} -eq 0 ] || die "--all takes no names"
    while IFS= read -r name; do names[${#names[@]}]=$name; done < <(machines_in stopped)
    [ ${#names[@]} -gt 0 ] || die "no stopped machine to start"
  fi
  need "${names[0]:-}" "<name ...> [--type [type]] [--till time] | --all"
  if [ ${#names[@]} -gt 1 ]; then
    [ -z "$retype" ] || die "--type takes one machine"
    start_many "${names[@]}"
    return
  fi
  name=${names[0]}
  exists "$name"
  case $(get "$name" .state) in
    running) die "$name is already running; if its start was cut short: ./node-ctl apply $name" ;;
    archived) die "$name is archived; use: ./node-ctl restore $name" ;;
  esac
  # There is no server to resize while a machine is stopped, only the snapshot of its disk: the
  # type it boots into is free to change here, as long as that type is sold in its location right
  # now and its disk holds the snapshot. Validated before the first action, not inside one.
  if [ -n "$retype" ]; then
    [ "$(provider_of "$name")" != contabo ] || die "--type is Hetzner-only: a Contabo upgrade changes the contract, not the machine (ADR-0018)"
    choose_type "$name" start
    if [ "$type" = "$current" ]; then retype='' # nothing to change: the machine starts as what it already is
    else info "$name starts as $type instead of $current"; fi
  fi
  [ -n "$retype" ] || type=''
  start_steps "$name" "$type" "Apply Terraform" "Wait for $name" || die "$FAIL_MESSAGE"
  apply "./node-ctl apply $name" # it finishes the start: wait_ready included
  wait_ready "$name"
  cato_after_start "$name"
  echo "ready: ./node-ctl ssh $name"
}
start_steps() { # start_steps <name> <new type or empty> [step ...]: plans its own steps, then those; everything up to the apply
  local name=$1 type=$2 steps=("Write inventory")
  shift 2
  [ -z "$TILL" ] || steps[1]="Schedule the stop"
  if [ "$(provider_of "$name")" = contabo ]; then
    # Its instance was only powered off, so it still holds its tailnet node and its name with it.
    # A machine that was never applied is powered on by nobody: the API call simply has nothing to
    # find, which is why a failure here is a warning and the apply below creates it.
    plan "Power on" "${steps[@]}" "$@"
    power_on "$name" || warn "could not power $name on; the apply below creates it if it does not exist yet"
  else
    plan "Free the tailnet name" "${steps[@]}" "$@"
    free_tailnet_name "$name" || { FAIL_MESSAGE="could not confirm $name is free on the tailnet; fix Tailscale API access, then retry"; return 1; }
  fi
  if [ -n "$type" ]; then
    with_action "Write inventory" inventory edit "$name" --arg t "$type" '.state = "running" | .started = (now | floor) | .type = $t'
  else
    with_action "Write inventory" inventory edit "$name" '.state = "running" | .started = (now | floor)'
  fi || return 1
  if [ -n "$TILL" ]; then with_action "Schedule the stop" schedule schedule_stop "$name" "$TILL"
  else schedule_stop "$name" ''; fi # a job left from an earlier run must not stop this one
}

# The stop has to run here: its snapshot needs the account's token and the local Terraform state, so a
# launchd job of this user does it. launchd runs a job missed while the Mac slept on wake, and RunAtLoad
# runs it at the next login; the job itself compares the clock, so neither can stop the machine early.
# shortcut: launchd only (macOS hosts); a Linux host would need a systemd --user timer.
# shortcut: a failed stop is retried every minute until it succeeds; no notification, read the log.
TILL=''
LAUNCH_AGENTS=${LAUNCH_AGENTS:-$HOME/Library/LaunchAgents}
till_at() { # till_at <HH:MM | YYYY-MM-DD HH:MM | 6h | 6.9h | 90m>: TILL = that moment of this computer's time zone, or now plus that long, in seconds; HH:MM already past is tomorrow
  local t=$1 fmt=%H:%M s
  command -v launchctl > /dev/null || die "--till needs launchd, which only macOS has"
  if [[ $t =~ ^([0-9]+(\.[0-9]+)?)([hm])$ ]]; then
    # bash has no fractions; awk rounds 6.9h to whole seconds
    s=$(awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[3]}" 'BEGIN { printf "%d", n * (u == "h" ? 3600 : 60) + 0.5 }')
    [ "$s" -gt 0 ] || die "--till $t: the machine would stop at once"
    TILL=$(($(date +%s) + s))
    return
  fi
  case $t in
    [0-2][0-9]:[0-5][0-9]) ;;
    [0-9][0-9][0-9][0-9]-[01][0-9]-[0-3][0-9]\ [0-2][0-9]:[0-5][0-9]) fmt="%Y-%m-%d %H:%M" ;;
    *) die "--till takes HH:MM or \"YYYY-MM-DD HH:MM\" in this computer's time zone, or how long: 6h, 6.9h, 90m; not: ${t:-nothing}" ;;
  esac
  s=$(date -j -f "$fmt:%S" "$t:00" +%s 2>/dev/null) || die "--till: not a time: $t"
  # BSD date rolls 25:00 or February 30 over instead of refusing them
  [ "$(date -j -r "$s" "+$fmt")" = "$t" ] || die "--till: not a time: $t"
  if [ "$s" -le "$(date +%s)" ]; then
    [ "$fmt" = %H:%M ] || die "--till $t is already past"
    s=$(date -j -v+1d -f "$fmt:%S" "$t:00" +%s)
  fi
  TILL=$s
}
schedule_stop() { # schedule_stop <name> <seconds or empty>: a launchd job that stops it then; empty only drops the old one
  local name=$1 at=$2 label=com.node-ctl.stop.$1 domain plist inv
  domain=gui/$(id -u) plist=$LAUNCH_AGENTS/$label.plist
  if [ -f "$plist" ]; then launchctl bootout "$domain/$label" 2> /dev/null; rm -f "$plist"; fi
  [ -n "$at" ] || return 0
  inv=$(cd "$SERVERS" && pwd)/$name.json
  mkdir -p "$LAUNCH_AGENTS" && cat > "$plist" <<EOF && launchctl bootstrap "$domain" "$plist" && action_log "$name stops at $(date -r "$at" '+%Y-%m-%d %H:%M %Z')"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-c</string>
    <string>[ "\$(date +%s)" -ge $at ] || exit 0
if [ "\$(jq '.state == "running" or .stopping != null' '$inv' 2>/dev/null)" = true ]; then '$PWD/node-ctl' --progress=plain stop '$name' || exit 1; fi
rm -f '$plist'; launchctl bootout $domain/$label</string>
  </array>
  <key>WorkingDirectory</key><string>$PWD</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$PATH</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/node-ctl-stop-$name.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/node-ctl-stop-$name.log</string>
</dict>
</plist>
EOF
}
start_many() { # start_many <name ...>: one apply for all of them; one that cannot be prepared stays stopped
  local name started=() failed='' steps=()
  for name in "$@"; do # before the first action
    exists "$name"
    case $(get "$name" .state) in
      stopped) ;;
      archived) die "$name is archived; use: ./node-ctl restore $name" ;;
      *) die "$name is already running; if its start was cut short: ./node-ctl apply $name" ;;
    esac
    steps[${#steps[@]}]="Start $name"
  done
  for name in "$@"; do steps[${#steps[@]}]="Wait for $name"; done
  plan "${steps[@]:0:$#}" "Apply Terraform" "${steps[@]:$#}"
  for name in "$@"; do
    if with_action "Start $name" machine start_steps "$name" ''; then started[${#started[@]}]=$name; else failed="$failed $name"; fi
  done
  [ ${#started[@]} -gt 0 ] || die "could not start:$failed; they are still stopped, retry: ./node-ctl start$failed"
  apply "./node-ctl apply ${started[*]}"
  for name in "${started[@]}"; do wait_ready "$name" && cato_after_start "$name" && echo "ready: ./node-ctl ssh $name"; done
  [ -z "$failed" ] || die "could not start:$failed; they are still stopped, retry: ./node-ctl start$failed"
}

# The disk follows the type only on request (keep_disk in terraform/main.tf, from the inventory):
# a grown disk never shrinks, so every type with a smaller one is out from then on. Hetzner resizes
# a powered-off server, which Terraform does for us: the machine reboots, the tailnet address survives.
server_types() { # server_types <name> <location> <current type> <disk GB>: "name cores ram cpu disk price yes|no" per line, cheapest first
  hc "$1" scripts/server-types.sh move "$2" "$3" "$4"
}
disk_of() { # disk_of <name>: the machine's disk in GB, from Hetzner; empty when nothing of it exists there
  hcloud_image disk "$1" "$(get "$1" '.image // empty')" 2>/dev/null
}
type_disk() { printf '%s\n' "$1" | awk -F'\t' -v t="$2" '$1 == t { print $5 }'; } # type_disk <rows> <type>

# The last column of the type table says whether the row can be picked at all: a resize asks
# Hetzner whether it moves a server there (yes/no), a create lists the locations that sell it.
TYPE_LAST=MOVE
TYPE_HINT='* current · no = Hetzner will not move it there now'
row_ok() { [ "${1##*$'\t'}" != no ]; }
movable_types() { printf '%s\n' "$1" | awk -F'\t' '$7 == "yes" { print $1 }'; } # movable_types <rows>
type_column() { # type_column <name>: the heading says what a pick would actually do to that machine
  if [ "$(get "$1" .state)" = running ]; then
    TYPE_LAST=MOVE TYPE_HINT='* current · no = Hetzner will not move it there now'
  else
    TYPE_LAST=CREATE TYPE_HINT='* current · no = too small for the snapshot, or not sold there now'
  fi
}

type_row() { # type_row <tsv row> <current>: one aligned line, the machine's own type marked
  local name cores ram cpu disk price move
  IFS=$'\t' read -r name cores ram cpu disk price move <<< "$1"
  printf ' %s %-12s %5s %5sG %10s %5sG %9.2f %s' "$([ "$name" != "$2" ] && printf ' ' || printf '*')" \
    "$name" "$cores" "$ram" "$cpu" "$disk" "$price" "$move"
}

# Hetzner offers more types than a terminal has rows, which is what the menu's window is for. Types
# it will not take right now stay in the list, dimmed and marked, but the selection walks past them:
# they are priced there and refusing one silently is what leaves a machine stopped.
pick_type() { # pick_type <rows> <current>: the chosen type on stdout (a typed one as it is), the menu on stderr
  local row i=0 MENU_VALUES=() MENU_LINES=() MENU_SKIP=' ' MENU_HINT=$TYPE_HINT MENU_HEADER
  MENU_HEADER=$(printf '   %-12s %5s %6s %10s %6s %9s %s' TYPE CORES RAM CPU DISK 'EUR/mo' "$TYPE_LAST")
  while IFS= read -r row; do
    MENU_VALUES[i]=${row%%$'\t'*} MENU_LINES[i]=$(type_row "$row" "$2")
    i=$((i + 1))
    row_ok "$row" || MENU_SKIP="$MENU_SKIP$i "
  done <<< "$1"
  menu type "$2"
}

# resize moves a running machine into another type; start --type boots a stopped one into it from its
# snapshot. Either way the type has to hold the disk and be on offer in the location, so both ask the
# same list and refuse the same way, before the first action.
choose_type() { # choose_type <name> <resize|start>: sets the caller's current, location, disk, rows and type (asked when empty)
  local name=$1 verb=$2 movable how='move to' opt=''
  [ "$verb" != start ] || { how='start as' opt=' --type'; }
  current=$(get "$name" .type)
  location=$(get "$name" .location)
  disk=$(disk_of "$name") || disk=''
  rows=$(server_types "$name" "$location" "$current" "$disk") || die "could not read the server types from the Hetzner API"
  [ -n "$disk" ] || disk=$(type_disk "$rows" "$current")
  movable=$(movable_types "$rows")
  [ -n "$movable" ] || die "Hetzner offers no type in $location that takes the ${disk}G disk of $name right now; another location needs archive + create"
  if [ -z "$type" ]; then
    if [ "$verb" = start ]; then
      info "$name is $current in $location; it boots from a ${disk}G snapshot, so a type with a smaller
disk, or one $location will not create right now, is marked no and the selection walks past it."
    else
      info "$name is $current in $location with a ${disk}G disk; the machine reboots into the new type.
A type with a bigger disk can grow it (asked next; a grown disk never shrinks); one with a smaller disk,
or one Hetzner will not move a server into right now, is marked no and the selection walks past it."
    fi
    type_column "$name"
    type=$(pick_type "$rows" "$current") || die "nothing to read a type from; pass one: ./node-ctl $verb $name$opt <type>"
  fi
  [ "$type" != "$current" ] || return 0
  ! printf '%s\n' "$movable" | grep -qxF "${type:-}" || return 0
  ! printf '%s\n' "$rows" | cut -f1 | grep -qxF "${type:-}" \
    || die "$name cannot $how $type in $location: its disk is smaller than ${disk}G, or Hetzner will not take it there right now (no in the list)"
  die "$name cannot $how '${type:-}' in $location; ./node-ctl $verb $name$opt lists the types that work"
}

cmd_resize() {
  need "${1:-}" "<name> [type] [--grow-disk|--keep-disk]"
  local name=$1 type='' grow='' a current location disk target rows
  for a in "${@:2}"; do case $a in --grow-disk) grow=1 ;; --keep-disk) grow=0 ;; *) type=$a ;; esac; done
  exists "$name"
  [ "$(provider_of "$name")" != contabo ] || die "resize is Hetzner-only: a Contabo upgrade changes the contract, not the machine (ADR-0018)"
  choose_type "$name" resize
  [ "$type" != "$current" ] || { echo "$name is already $current"; return; }
  # Asked on a terminal, --grow-disk or --keep-disk answers it anywhere else; the default is to keep.
  target=$(type_disk "$rows" "$type")
  [ "$target" -gt "$disk" ] || grow=0 # nothing to grow into
  if [ -z "$grow" ] && [ -t 0 ]; then
    ! yes_no "Grow the disk from ${disk}G to ${target}G? It never shrinks again, so no smaller type afterwards" || grow=1
  fi
  [ "$(get "$name" .state)" = running ] || info "$name is not running: the new type applies at the next start"
  plan "Write inventory" "Apply Terraform"
  with_action "Write inventory" inventory edit "$name" --arg t "$type" --argjson k "$([ "$grow" = 1 ] && echo false || echo true)" '.type = $t | .keep_disk = $k'
  # Terraform stops the machine before it changes the type, and a type Hetzner cannot place
  # (resource_unavailable: sold out in that location) leaves it stopped for good — no attribute
  # tracks power state, so no later apply would start it again. Put the type back and boot it.
  if ! with_action "Apply Terraform" apply do_apply; then
    with_action "Write inventory" inventory edit "$name" --arg t "$current" '.type = $t'
    with_action "Power $name on again" poweron action_run hc "$name" scripts/poweron.sh "$name" \
      || warn "could not power $name on; do it in the Hetzner console"
    die "$name stayed on $current: Hetzner refused $type (see the apply output above)"
  fi
  update_ssh_config
  echo "$name: $current -> $type$([ "$grow" != 1 ] || echo ", disk ${target}G")"
}

cmd_volume() {
  need "${1:-}" "<name> <size GB>"
  local name=$1 size=${2:-} running=''
  if [ -z "$size" ] && [ -t 0 ]; then size=$(ask_volume_size); [ "$size" != 0 ] || die "aborted"; fi
  need "$size" "<name> <size GB>"
  exists "$name"
  [ "$(provider_of "$name")" != contabo ] || die "volumes are Hetzner-only: Contabo has no block storage to attach (ADR-0018)"
  [[ $size =~ ^[1-9][0-9]*$ ]] || die "not a volume size in GB: $size"
  [ "$(get "$name" '.volume_size // 0')" = 0 ] || die "$name already has a volume (README: Growing a volume)"
  [ "$(get "$name" .state)" != running ] || running=1
  plan "Write inventory" "Apply Terraform" ${running:+"Mount the volume"}
  with_action "Write inventory" inventory edit "$name" --argjson s "$size" '.volume_size = $s'
  apply
  [ -z "$running" ] || with_action "Mount the volume" volume action_run mount_volume "$name" # a stopped machine mounts it at the next start
  echo "$name: ${size}G at /mnt/volume"
}

cmd_destroy() {
  need "${1:-}" "<name> [--yes]"
  local name=$1 running='' snap=1 what="its disk and snapshot"
  [ "${2:-}" != --yes ] || YES=1
  exists "$name"
  # Contabo keeps no snapshot, and deleting an instance there cancels a monthly contract (ADR-0018).
  [ "$(provider_of "$name")" != contabo ] || { snap=''; what="its disk; the Contabo contract is cancelled and billed to the end of the paid period"; }
  [ "$(get "$name" '.volume_size // 0')" = 0 ] || what="$what AND its volume"
  confirm "This deletes $name, $what." "$name"
  [ "$(get "$name" .state)" != running ] || running=1
  plan ${running:+"Leave the tailnet"} ${snap:+"Delete the root disk snapshot"} "Write inventory" "Apply Terraform"
  [ -z "$running" ] || leave_tailnet "$name"
  [ -z "$snap" ] || prune_images "$name"
  with_action "Write inventory" inventory rm "$SERVERS/$name.json"
  apply
}

cmd_list() {
  local files=("$SERVERS"/*.json) addr json=false
  [ "${1:-}" != --json ] || json=true
  [ ${#files[@]} -gt 0 ] || { if $json; then echo '[]'; else echo "no machines"; fi; return; }
  addr=$(tf_machines) # no state yet (or no terraform init): the table just has no addresses
  # The tailnet's view, one call: tailscale up is the last step of provision.sh, so a running
  # machine that is online there is ready and one that is not is still starting. A node the
  # tailnet lists offline (a stopped machine's leftover) is not a name worth showing.
  local ts='{}' cli=''
  if cli=$(tailscale_cli); then
    ts=$("$cli" status --json 2>/dev/null | jq -c '[ .Peer // {} | .[] | (.DNSName | rtrimstr(".")) as $n
      | { key: ($n | split(".")[0]), value: { name: $n, online: .Online } } ] | from_entries') || ts='{}'
  fi
  local stops='{}' p
  for p in "$LAUNCH_AGENTS"/com.node-ctl.stop.*.plist; do # a stop job holds its moment as "-ge <seconds>"
    [ -f "$p" ] || continue
    p=$(grep -o -- '-ge [0-9]*' "$p" | jq -R --arg n "${p##*.stop.}" '{ ($n | rtrimstr(".plist")): (split(" ")[1] | tonumber) }') &&
      stops=$(jq -c --argjson s "$p" '. + $s' <<< "$stops")
  done
  local stopping='[]' f
  while read -r f p; do # a stop's mark counts while its node-ctl still runs
    ! ps -p "$p" -o command= 2> /dev/null | grep -q node-ctl || stopping=$(jq -c --arg n "$(basename "$f" .json)" '. + [$n]' <<< "$stopping")
  done < <(jq -r 'select(.state == "running" and .stopping) | "\(input_filename) \(.stopping)"' "${files[@]}")
  jq -nr --argjson tf "$addr" --argjson ts "$ts" --argjson cli "$([ -n "$cli" ] && echo true || echo false)" \
      --argjson stops "$stops" --argjson stopping "$stopping" --argjson json "$json" --arg b "$B" --arg d "$D" --arg n "$N" "$JQ_TABLE"'
    def name: input_filename | sub(".*/"; "") | sub("\\.json$"; "");
    def dash: if . == "" then "-" else . end;
    def two: tostring | if length < 2 then "0" + . else . end;
    def up: if . >= 86400 then "\(. / 86400 | floor)d\(. % 86400 / 3600 | floor | two)h"
      elif . >= 3600 then "\(. / 3600 | floor)h\(. % 3600 / 60 | floor | two)m" else "\(. / 60 | floor)m" end;
    def online: $ts[.name].online // false;
    def tailscale: if .state == "running" and online then $ts[.name].name else null end;
    def state: if .state != "running" then .state elif .name as $m | $stopping | index([$m]) then "stopping"
      elif $cli | not then .state elif online then "ready" else "starting" end;
    [ inputs | { name: name, account: (.account // null), state, ipv4: ($tf[name].ipv4 // null), ipv6: ($tf[name].ipv6 // null),
                 open_ports, funnel: (.funnel // {}),
                 started: (if .state == "running" then .started else null end),
                 stops_at: (if .state == "running" then $stops[name] else null end) } ]
    | map(. + { state: state, tailscale: tailscale })
    | if $json then . else
      [ [ "NAME", "ACCOUNT", "STATE", "UPTIME", "AUTOSTOP", "IPV4", "TAILSCALE", "PORTS", "FUNNEL" ] ]
      + map([ .name, (.account // "-"), .state,
              (if .started then now - .started | floor | up else "-" end),
              (if .stops_at then .stops_at | strflocaltime("%Y-%m-%d %H:%M") else "-" end),
              (.ipv4 // "-"), (.tailscale // "-"),
              (.open_ports | map(tostring) | join(",") | dash),
              (.tailscale as $t | .funnel | to_entries
               | map("\(if $t then "https://\($t)" else "" end)\(.key) -> \(.value)") | join(", ") | dash) ])
      | table end' "${files[@]}"
}

# ssh re-splits the command line on the remote side, where an empty argument disappears: every
# argument below always carries a word.
load_report() { # load_report <name> <once|plain|tty> [color|mono] [block|row]
  tssh -o BatchMode=yes "node-ctl-user@$(addr "$1")" bash -s -- "$2" "${3:-mono}" "${4:-block}" <<'EOF'
set -euo pipefail
mode=$1 layout=$3
G='' R='' N=''
[ "$2" != color ] || { G='\033[32m' R='\033[31m' N='\033[0m'; }
cores=$(nproc)
dev=$(findmnt -no SOURCE /); dev=${dev##*/}
grep -q " $dev " /proc/diskstats || dev=$(printf '%s' "$dev" | sed -E 's/p?[0-9]+$//') # a partition may not keep its own stats
busy_ms() { awk -v d="$dev" '$3 == d { t = $13 } END { print t + 0 }' /proc/diskstats; } # field 13: ms the disk was busy
up= # after the first block, redraw over it instead of scrolling
while :; do
  read -r l1 l5 l15 _ < /proc/loadavg
  b0=$(busy_ms)
  idle=$(vmstat 1 2 | awk 'END {print $15}') # the second sample is a real one-second delta
  busy=$(( ($(busy_ms) - b0) / 10 )); [ "$busy" -le 100 ] || busy=100 # ms busy in that same second
  df=$(df -m / | awk 'NR == 2 {print $2, $3}') # /data and docker live on the root disk
  printf '%s' "$up"
  free -m | awk -v cores="$cores" -v cpu="$((100 - idle))" -v l1="$l1" -v l5="$l5" -v l15="$l15" \
                -v busy="$busy" -v dtotal="${df% *}" -v dused="${df#* }" -v layout="$layout" \
                -v G="$G" -v R="$R" -v N="$N" '
    function rep(ch, n,   i, s) { for (i = 0; i < n; i++) s = s ch; return s }
    function bar(pct, w,   n, green) { n = int(pct * w / 100 + 0.5); if (n > w) n = w; if (n < 0) n = 0
                                       green = int(w * 0.7); if (n < green) green = n # the last 30% of the bar is the red zone
                                       return G rep("|", green) R rep("|", n - green) N rep(" ", w - n) }
    /^Mem:/ { ram = 100 * $3 / $2; root = 100 * dused / dtotal
              if (layout == "row") { # one line per machine; node-ctl prints the header that names these columns
                printf "[%s] %3d%%  [%s] %3d%%  [%s] %5.2f  [%s] %3d%%  [%s] %3d%%  %5.1fG\n", bar(cpu, 8), cpu,
                       bar(ram, 8), ram, bar(100 * l1 / cores, 8), l1, bar(busy, 8), busy, bar(root, 8), root,
                       (dtotal - dused) / 1024
                next }
              printf "cpu  [%s] %3d%%  %d cores\n", bar(cpu, 20), cpu, cores
              printf "ram  [%s] %3d%%  %d/%d MiB\n", bar(ram, 20), ram, $3, $2
              printf "load [%s] %5.2f  5m %.2f  15m %.2f\n", bar(100 * l1 / cores, 20), l1, l5, l15
              printf "disk [%s] %3d%%  busy\n", bar(busy, 20), busy
              printf "root [%s] %3d%%  %.1f/%.1f GiB  %.1f free\n", bar(root, 20),
                     root, dused / 1024, dtotal / 1024, (dtotal - dused) / 1024 }'
  [ "$mode" != once ] || break
  [ "$mode" != tty ] || up=$'\033[5A'
done
EOF
}

# Every running machine as one row of the table, one ssh stream each, all in parallel: a slow or
# unreachable machine holds up nobody. Each stream overwrites its machine's file with the latest
# row; the table here is redrawn from those files every second.
LOAD_DIR='' LOAD_PIDS=''
load_rows() { # load_rows <name width> <names ...>: the header, a rule, and the latest row of each machine
  local w=$1 name row el=''
  shift
  [ -z "$TTY" ] || el=$'\033[K' # a shorter row erases the rest of the old one
  printf "%s%-${w}s  %-15s  %-15s  %-16s  %-15s  %-15s  %s%s\n" "$B" NAME CPU RAM LOAD DISK ROOT FREE "$N"
  printf "%s%s%s\n" "$D" "$(printf "%$((w + 94))s" '' | sed 's/ /─/g')" "$N"
  for name in "$@"; do
    row=$(cat "$LOAD_DIR/$name" 2>/dev/null) || row=-
    printf "%-${w}s  %s%s\n" "$name" "$row" "$el"
  done
}
load_alive() { local p; for p in $LOAD_PIDS; do ! kill -0 "$p" 2>/dev/null || return 0; done; return 1; }
load_all() { # load_all <once|plain|tty> <color|mono>
  local name names=() w=4 remote=plain
  while IFS= read -r name; do names[${#names[@]}]=$name; [ ${#name} -le "$w" ] || w=${#name}; done < <(running_machines)
  [ ${#names[@]} -gt 0 ] || die "no running machine"
  [ "$1" != once ] || remote=once
  LOAD_DIR=$(mktemp -d)
  # Ctrl-C does not reach background jobs of a script, so they are killed here; ssh then dies on
  # its next write into the closed pipe, and the loop on the machine with it.
  trap 'rc=$?; kill $LOAD_PIDS 2>/dev/null || true; rm -rf "$LOAD_DIR"; on_exit $rc' EXIT
  for name in "${names[@]}"; do
    { load_report "$name" "$remote" "$2" row 2>/dev/null || echo unreachable; } | while IFS= read -r row; do
      printf '%s\n' "$row" > "$LOAD_DIR/$name.new" && mv "$LOAD_DIR/$name.new" "$LOAD_DIR/$name" # whole rows only
    done &
    LOAD_PIDS="$LOAD_PIDS $!"
  done
  if [ "$1" = once ]; then
    # shellcheck disable=SC2086 # a list of pids
    wait $LOAD_PIDS
    load_rows "$w" "${names[@]}"
    return
  fi
  load_rows "$w" "${names[@]}"
  while load_alive; do
    sleep 1
    if [ "$1" = tty ]; then printf '\033[%dA' $((${#names[@]} + 2)); else echo; fi
    load_rows "$w" "${names[@]}"
  done
}

cmd_load() {
  local name='' mode=once color=mono a
  [ "${NODE_CTL_COLOR:-}" != 1 ] || color=color
  for a in "$@"; do
    case $a in
      -f | --follow) mode=plain; [ -z "$TTY" ] || mode='tty' ;; # a pipe gets plain lines, a terminal a redraw
      -*) die "usage: ./node-ctl load [-f] [name]" ;;
      *) name=$a ;;
    esac
  done
  [ -n "$name" ] || { load_all "$mode" "$color"; return; }
  exists "$name"
  load_report "$name" "$mode" "$color"
}

cmd_ports() {
  need "${1:-}" "<name> [port ...]"
  local name=$1
  shift
  exists "$name"
  [ $# -gt 0 ] || { get "$name" '.open_ports[]'; return; } # a bare call shows; closing everything is: ./node-ctl ports <name> 22
  local csv
  csv=$(ports_json "$@")
  plan "Write inventory" "Apply Terraform"
  with_action "Write inventory" inventory edit "$name" ".open_ports = [$csv]"
  apply
}

cmd_expose() {
  need "${1:-}" "<name> [<port> [/path] | --rm </path>]"
  local name=$1 path=/ port='' filter
  shift
  exists "$name"
  if [ $# -eq 0 ]; then get "$name" '.funnel // {} | to_entries[] | "\(.key) \(.value)"'; return; fi
  if [ "$1" = --rm ]; then
    need "${2:-}" "<name> --rm </path>"
    path=$2
    [ -n "$(get "$name" --arg p "$path" '.funnel[$p] // empty')" ] || die "nothing is published at $path on $name"
    filter='del(.funnel[$p])'
  else
    [[ $1 =~ ^[0-9]+$ ]] || die "usage: ./node-ctl expose <name> <port> [/path]"
    port=$1
    [ $# -eq 1 ] || path=$2
    [[ $path == /* ]] || die "the path must start with /: $path"
    filter='.funnel[$p] = $n'
  fi
  plan "Write inventory" "Configure Tailscale Funnel"
  with_action "Write inventory" inventory edit "$name" --arg p "$path" --argjson n "${port:-0}" "$filter"
  [ "$(get "$name" .state)" = running ] || { info "$name is not running: Funnel is configured at the next start"; return; }
  update_funnel "$name"
  [ -z "$port" ] || echo "https://$name.$(tailnet_suffix || true)$path -> $port"
}

cmd_gitkey() { # a machine created before the key existed, or before a rotation, gets the current one
  need "${1:-}" "<name>"
  exists "$1"
  [ -f "$GIT_KEY_FILE" ] || die "no $GIT_KEY_FILE: ./node-ctl init gitkey"
  [ "$(get "$1" .state)" = running ] || die "$1 is not running"
  install_git_key "$1"
}

cmd_autostop() { # start --till for a machine that is already running: same job, moved or dropped
  need "${2:-}" "<name> <time | off>"
  exists "$1"
  [ "$(get "$1" .state)" = running ] || die "$1 is not running; a start sets its autostop: ./node-ctl start $1 --till <time>"
  if [ "$2" = off ]; then
    schedule_stop "$1" ''
    echo "$1 has no autostop"
    return
  fi
  till_at "$2"
  with_action "Schedule the stop" schedule schedule_stop "$1" "$TILL" || die "could not schedule the stop of $1"
}

cmd_hostkeys() { # a machine rebuilt behind the CLI's back, or a store that was stale before the CLI knew about it
  need "${1:-}" "<name>"
  exists "$1"
  [ "$(get "$1" .state)" = running ] || die "$1 is not running"
  with_action "Refresh the host keys" hostkeys refresh_known_hosts "$1" \
    || die "nothing answered under any name of $1; its stale keys are gone, the new ones are not in yet"
  echo "host keys of $1 recorded"
}

# Cato's token is bound to the VPS it was issued on, so a machine booted from its snapshot has to sign in
# again, and its Google IdP only answers a real browser. The machine writes the login URL instead of
# opening a browser, this computer's browser answers it, and the redirect to 127.0.0.1 travels back over
# an ssh port forward. Everything on the machine runs as node-ctl-user: ~/.cato is its login.
CATO_URL=''
cato_request() { # cato_request <name>: the login URL in CATO_URL ("connected" when nothing is to do); the CLI there waits for the browser
  local name=$1 account user out
  account=$(get "$name" .cato.account) user=$(get "$name" .cato.user)
  out=$(remote "$name" 2>&1 <<EOF
set -euo pipefail
sdp=\$(command -v cato-sdp) || { echo "cato-sdp is not installed on $name"; exit 1; }
run() { sudo -u node-ctl-user -H "\$@"; }
if run "\$sdp" status 2>/dev/null | grep -q "pop name"; then echo connected; exit 0; fi
fake=~node-ctl-user/.cato-fakebrowser
install -d -o node-ctl-user -g node-ctl-user "\$fake"
cat > "\$fake/xdg-open" <<'XDG'
#!/bin/sh
echo "\$@" > "\$HOME/.cato-fakebrowser/url"
XDG
chmod 755 "\$fake/xdg-open"
rm -f "\$fake/url"
run "\$sdp" stop > /dev/null 2>&1 || true
run env DISPLAY=:0 "PATH=\$fake:\$PATH" setsid nohup "\$sdp" start --reset-cred --account '$account' --user '$user' \
  --use-systemd-resolv 1 --reconn 30 > "\$fake/log" 2>&1 < /dev/null &
for _ in \$(seq 1 60); do [ -s "\$fake/url" ] && break; sleep 1; done
[ -s "\$fake/url" ] || { echo "no login URL from cato-sdp after 60s:"; cat "\$fake/log"; exit 1; }
cat "\$fake/url"
EOF
) || { FAIL_MESSAGE=${out:-"could not reach $name"}; return 1; }
  CATO_URL=${out##*$'\n'}
}
cato_wait() { # cato_wait <name>: until the client there says which PoP it is on, five minutes at most
  remote "$1" <<'EOF'
for _ in $(seq 1 60); do
  pop=$(sudo -u node-ctl-user -H cato-sdp status 2>/dev/null | grep "pop name") && { echo "connected, $pop"; exit 0; }
  sleep 5
done
echo "still disconnected after 5 minutes:"; cat ~node-ctl-user/.cato-fakebrowser/log; exit 1
EOF
}
open_url() { if command -v open > /dev/null; then open "$1"; elif command -v xdg-open > /dev/null; then xdg-open "$1"; else info "open in a browser: $1"; fi; }
cato_signin() { # cato_signin <name> <url>: the browser here answers the URL; the redirect reaches the machine over the forward
  local name=$1 url=$2 port pid rc=0
  port=${url##*127.0.0.1:} port=${port%%[^0-9]*}
  [ -n "$port" ] || { FAIL_MESSAGE="no redirect port in the login URL: $url"; return 1; }
  tssh -N -o ExitOnForwardFailure=yes -L "$port:127.0.0.1:$port" "node-ctl-user@$(addr "$name")" &
  pid=$!
  action_log "sign in as $(get "$name" .cato.user) in the browser: $url"
  open_url "$url"
  action_run cato_wait "$name" || rc=$?
  kill "$pid" 2>/dev/null || true
  return "$rc"
}
cato_login() { # cato_login <name>: a machine without .cato has nothing to do
  [ -n "$(get "$1" '.cato // empty')" ] || return 0
  with_action "Request a Cato login URL from $1" cato-url cato_request "$1" || return 1
  if [ "$CATO_URL" = connected ]; then info "Cato is already connected on $1"; return 0; fi
  with_action "Sign in to Cato" cato-signin cato_signin "$1" "$CATO_URL"
}
cato_after_start() { cato_login "$1" || warn "${FAIL_MESSAGE:-Cato is not connected on $1}; retry: ./node-ctl cato $1"; }
cmd_cato() {
  local name=${1:-}
  need "$name" "<name> [account user]"
  exists "$name"
  [ "$(get "$name" .state)" = running ] || die "$name is not running"
  case $# in
    1) [ -n "$(get "$name" '.cato // empty')" ] || die "$name has no Cato account yet: ./node-ctl cato $name <account> <user>" ;;
    3) edit "$name" --arg a "$2" --arg u "$3" '.cato = {account: $a, user: $u}' ;;
    *) die "usage: ./node-ctl cato <name> [account user]" ;;
  esac
  cato_login "$name" || die "${FAIL_MESSAGE:-Cato sign-in failed on $name}"
  echo "Cato connected on $name"
}

cmd_backup() {
  need "${1:-}" "<name>"
  local name=$1
  exists "$name"
  require_restic
  [ "$(get "$name" .state)" = running ] || die "$name is not running"
  snapshot "$name"
}

cmd_archive() {
  need "${1:-}" "<name>"
  local name=$1
  exists "$name"
  require_restic
  [ "$(get "$name" .state)" = running ] || die "$name is not running"
  local snap=1
  [ "$(provider_of "$name")" != contabo ] || snap='' # no disk snapshot there; the apply cancels the contract
  plan "Snapshot /data of $name" "Leave the tailnet" ${snap:+"Delete the root disk snapshot"} "Write inventory" "Apply Terraform"
  snapshot "$name"
  leave_tailnet "$name"
  [ -z "$snap" ] || prune_images "$name" # restic holds the data now; the disk snapshot would only be billed
  with_action "Write inventory" inventory edit "$name" '.state = "archived"'
  apply
}

cmd_restore() {
  need "${1:-}" "<name> [snapshot] [--yes]"
  local name=$1 snapshot=latest a start=''
  for a in "${@:2}"; do case $a in --yes) YES=1 ;; *) snapshot=$a ;; esac; done
  exists "$name"
  require_restic
  [ "$(get "$name" .state)" = running ] || start=1
  [ -n "$start" ] || confirm "This overlays snapshot $snapshot onto /data of the running machine $name." "$name"
  local selector=$snapshot
  [ "$snapshot" != latest ] || selector="latest --tag $name"
  # A stopped Contabo instance is powered off, and no apply would ever start it again (ADR-0018).
  local power=''
  [ -z "$start" ] || [ "$(provider_of "$name")" != contabo ] || power=1
  plan ${power:+"Power on"} ${start:+"Write inventory" "Apply Terraform"} "Wait for $name" "Restore /data of $name"
  [ -z "$power" ] || power_on "$name" || warn "could not power $name on; the apply below creates it if it does not exist yet"
  if [ -n "$start" ]; then
    with_action "Write inventory" inventory edit "$name" '.state = "running" | .started = (now | floor)'
    apply
  fi
  wait_ready "$name"
  with_action "Restore /data of $name" restore action_run restore_data "$name" "$selector"
  echo "restored: ./node-ctl ssh $name"
}

cmd_ssh() {
  need "${1:-}" "<name> [cmd ...]"
  local name=$1
  shift
  tssh "node-ctl-user@$(addr "$name")" "$@"
}

# The accounts of node-ctl.yaml, and the one dialogue that writes them. Adding and changing are the
# same question — init_hetzner and init_contabo ask for a tag and replace what an existing one holds —
# so this command is a listing plus that step, without the rest of init.
pick_provider() { # pick_provider [name]: hetzner or contabo, asked on stdin when not given
  local answer=${1:-} MENU_VALUES=(hetzner contabo) MENU_LINES=(' hetzner' ' contabo')
  [ -n "$answer" ] || answer=$(menu cloud) || die "aborted"
  case $answer in
    hetzner | contabo) echo "$answer" ;;
    *) die "not a cloud: $answer (hetzner, contabo)" ;;
  esac
}

accounts_add() { # accounts_add [hetzner|contabo]: ask until the credentials verify, then register the ssh key
  local provider
  provider=$(pick_provider "${1:-}") # before the first action: a die inside one cannot abort it
  ensure_config_writable
  INIT_FORCE=1 # an explicit add asks, where init would keep what already works
  ACCOUNTS_ADD=1
  info "Writing $CONFIG_FILE after every account; a failed check repeats the question, Ctrl-C keeps what is saved."
  plan "$provider" "Apply Terraform"
  with_action "$provider" "$provider" init_step "$provider"
  apply
}

cmd_accounts() {
  case ${1:-} in add | edit) accounts_add "${2:-}"; return ;; esac
  [ -z "${1:-}" ] || [ "$1" = --json ] || die "usage: ./node-ctl accounts [--json] | accounts add|edit [hetzner|contabo]"
  local json=false files=("$SERVERS"/*.json) counts='{}'
  [ "${1:-}" != --json ] || json=true
  [ ${#files[@]} -eq 0 ] || counts=$(jq -s -c 'map(.account // "") | group_by(.) | map({key: .[0], value: length}) | from_entries' "${files[@]}")
  [ -n "$(accounts)" ] || { if $json; then echo '[]'; else echo "no cloud account in $CONFIG_FILE: ./node-ctl accounts add"; fi; return; }
  account_labels | jq -Rnr --argjson c "$counts" --argjson json "$json" --arg b "$B" --arg d "$D" --arg n "$N" "$JQ_TABLE"'
    [ inputs | split("/") | { provider: .[0], tag: .[1], machines: ($c[.[1]] // 0) } ]
    | if $json then . else
      [ [ "CLOUD", "ACCOUNT", "MACHINES" ] ] + map([ .provider, .tag, (.machines | tostring) ]) | table end'
}

cmd_apply() {
  local name names
  for name in "$@"; do exists "$name"; [ "$(get "$name" .state)" = running ] || die "$name is not running"; done
  names=${*:-$(running_machines)}
  apply
  [ -z "$names" ] || { ensure_key; ensure_tailscale; } # the inventory is applied by now: no tailnet only stops the sync
  # A named machine may be a start cut short (its VPS created only now): it gets what start gives it.
  if [ $# -gt 0 ]; then for name; do wait_ready "$name"; done; return; fi
  for name in $names; do install_agent_files "$name" || warn "could not sync the agent setup to $name"; done
}
cmd_test() {
  scripts/test.sh
  (cd progress && npm ci --no-audit --no-fund --loglevel=error && npm run check)
}
cmd_version() { git log -1 --format='node-ctl %h (%cs)' 2>/dev/null || echo "node-ctl (not a git checkout)"; }

# --- setup: ./node-ctl init and ./node-ctl check --------------------------------------------------------

check_creds() { # check_creds [hetzner|contabo|tailscale|restic]: probe credentials against the APIs, as actions under the current one
  open_renderer
  NODE_CTL_PARENT=${ACTIONS##* } NODE_CTL_ACCOUNTS=$(cfg -c '.hetzner // {}') NODE_CTL_CONTABO=$(cfg -c '.contabo // {}') \
    scripts/check.sh "$@" >&3
}

PROBES=0 FAILED=0
probe() { # probe <name> <ok detail> <failure detail> <command ...>: one child action per check
  local name=$1 key
  key=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-')
  PROBES=$((PROBES + 1))
  key=${key#-} key=${key%-}
  with_action "$name" "$key" probe_run "${@:2}" || FAILED=$((FAILED + 1))
}
probe_run() { # probe_run <ok detail> <failure detail> <command ...>
  local out
  if out=$("${@:3}" 2>&1 >/dev/null); then [ -z "$1" ] || action_log "$1"; else FAIL_MESSAGE="$2${out:+: $out}"; return 1; fi
}
group() { # group <command ...>: runs probes; fails when any of them did
  local f0=$FAILED p0=$PROBES
  "$@"
  [ "$FAILED" -eq "$f0" ] || { FAIL_MESSAGE="$((FAILED - f0)) of $((PROBES - p0)) checks failed"; return 1; }
}

ask() { # ask [-s] <var> <hint>: prompt with the current value as default (-s hides input and default); exports the answer
  local secret='' v cur val prompt
  [ "$1" != -s ] || { secret=-s; shift; }
  # The renderer is another process writing to the same stderr, so a prompt printed while it still has
  # lines to draw lands in the middle of them. Closing it drains what is pending; the next event reopens it.
  close_renderer
  v=$1 cur=${!1:-}
  printf '\n%s\n' "$2" >&2
  if [ -z "$cur" ]; then prompt="$v [empty]: "
  elif [ -n "$secret" ]; then prompt="$v [(set)]: "
  else prompt="$v [$cur]: "; fi
  # shellcheck disable=SC2086,SC2229 # $secret is empty or -s; macOS bash 3.2 rejects "${arr[@]}" on an empty array
  read -r $secret -p "$prompt" val || die "aborted"
  [ -z "$secret" ] || echo >&2
  val=${val/#\~/$HOME}
  export "$v=${val:-$cur}"
}

# valid_<step>: the step's values are present and work, so init keeps them without asking
valid_ssh() { [ -r "$SSH_PUBLIC_KEY_FILE" ] && ensure_key && ensure_ssh_include; } # both fix what they check, like ensure_key loading the agent
valid_link() { linked "$BIN_DIR/node-ctl" "$PWD/node-ctl" && linked "$SKILLS_DIR/node-ctl-migrate" "$PWD/skills/node-ctl-migrate"; }
linked() { [ "$(readlink "$1" 2>/dev/null)" = "$2" ]; }
valid_gitkey() { [ -r "$GIT_KEY_FILE" ]; }
valid_hetzner() { [ -n "$(accounts)" ] && check_creds hetzner; }
valid_contabo() { [ -z "$(cfg '.contabo // {} | keys[]')" ] || check_creds contabo; } # no Contabo account is a valid answer
valid_tailscale() {
  [ -n "${TAILSCALE_OAUTH_CLIENT_ID:-}" ] && [ -n "${TAILSCALE_OAUTH_CLIENT_SECRET:-}" ] && check_creds tailscale
}
valid_restic() {
  local v
  for v in "${RESTIC_VARS[@]}"; do [ -n "${!v:-}" ] || return 1; done
  check_creds restic
}

init_ssh() {
  local ssh_public_key_file=$SSH_PUBLIC_KEY_FILE
  ask ssh_public_key_file "Public key installed for node-ctl-user on every machine. No key yet? ssh-keygen -t ed25519"
  [ -r "$ssh_public_key_file" ] || { warn "cannot read $ssh_public_key_file"; return 1; }
  cfg_set .ssh_public_key_file "$ssh_public_key_file" || return 1
  ensure_key || { warn "ssh-agent could not load the key"; return 1; }
  ensure_ssh_include || warn "could not add '$SSH_INCLUDE' to $SSH_DIR/config; plain 'ssh <machine>' will not work"
}
init_link() { # node-ctl on PATH (the cd at the top follows the link back here) and the skill where Claude Code looks for skills
  link_into "$BIN_DIR" node-ctl "$PWD/node-ctl"
  link_into "$SKILLS_DIR" node-ctl-migrate "$PWD/skills/node-ctl-migrate"
  case ":$PATH:" in *":$BIN_DIR:"*) ;; *) warn "$BIN_DIR is not on PATH; add it to run node-ctl from any directory" ;; esac
}
link_into() { # link_into <dir> <name> <target>: a symlink. Never fails: init must not stall on it
  local link=$1/$2
  if [ -e "$link" ] && [ ! -L "$link" ]; then warn "$link exists and is not a symlink; left alone"; return 0; fi
  { mkdir -p "$1" && ln -sfn "$3" "$link" && info "linked $link"; } || warn "could not link $link"
  return 0
}
init_gitkey() { # kept once generated: a new key would have to be registered with every git host again
  if [ -r "$GIT_KEY_FILE" ]; then info "keeping $GIT_KEY_FILE (delete it to generate a new one)"
  else
    info "ssh-keygen asks for a passphrase next; empty means none, which is what lets an agent on a
machine push unattended. A passphrase has to be typed on the machine at every push."
    # ssh-keygen asks on the terminal itself (a passphrase in -N would stand in the process list),
    # and it asks straight away, while the renderer is still drawing this step in its own container.
    # Waiting for the renderer to drain and exit puts the prompt after the lines that explain it;
    # the next event starts a fresh renderer.
    close_renderer
    if ! { mkdir -p "$(dirname "$GIT_KEY_FILE")" \
        && ssh-keygen -q -t ed25519 -C "node-ctl-user commit key" -f "$GIT_KEY_FILE"; }; then
      warn "could not generate $GIT_KEY_FILE"
      return 1
    fi
    info "generated $GIT_KEY_FILE; it is installed for node-ctl-user on every machine, keep a copy"
  fi
  info "add this public key to your git host (GitHub: Settings -> SSH and GPG keys):
$(cat "$GIT_KEY_FILE.pub")"
}
init_hetzner() { # every account in turn: a tag of the user's choice, then that project's token; an empty tag ends the list
  local hetzner_account hetzner_token existing added=0
  while :; do
    existing=$(accounts | paste -s -d ' ' -)
    hetzner_account=''; [ -n "$existing" ] || hetzner_account=main
    ask_tag hetzner_account "Hetzner account: a short tag of your choice for one Hetzner project (its API token is asked next)." \
      "$(cfg '.hetzner // {} | keys[]')" "$added" "Empty = done adding accounts"
    [ -n "$hetzner_account" ] || { must_add "$added" && continue; break; }
    [[ $hetzner_account =~ ^[a-z0-9][a-z0-9-]*$ ]] || { warn "a tag is lowercase letters, digits and dashes"; continue; }
    hetzner_token=$(token_of "$hetzner_account")
    ask -s hetzner_token "Hetzner Cloud console -> that project -> Security -> API tokens -> Generate API token, permission Read & Write"
    cfg_set ".hetzner[\"$hetzner_account\"]" "$hetzner_token" || return 1
    added=$((added + 1))
  done
  [ -n "$(accounts)" ] || { warn "at least one Hetzner account is needed"; return 1; }
  check_creds hetzner
}
# Contabo is optional and asked the same way: a tag of the user's choice, then that account's API
# credentials (an OAuth client plus the API user, all four on one page of the panel). The API user is
# its own identity, not the panel login, and its password is set through a link the panel mails out.
init_contabo() {
  local contabo_account contabo_client_id contabo_client_secret contabo_user contabo_password t added=0
  while :; do
    contabo_account=''
    ask_tag contabo_account "Contabo account: a short tag of your choice for one Contabo customer account
(its API credentials are asked next)." "$(cfg '.contabo // {} | keys[]')" "$added" "Empty = done, no Contabo"
    [ -n "$contabo_account" ] || { must_add "$added" && continue; break; }
    [[ $contabo_account =~ ^[a-z0-9][a-z0-9-]*$ ]] || { warn "a tag is lowercase letters, digits and dashes"; continue; }
    [ -z "$(token_of "$contabo_account")" ] || { warn "$contabo_account already names a Hetzner account; a tag names one account"; continue; }
    t=$contabo_account
    eval "$(contabo_creds "$t" contabo_client_id contabo_client_secret contabo_user contabo_password)"
    ask contabo_client_id "Customer Control Panel -> Account -> Security & Access -> API credentials: the Client ID"
    ask -s contabo_client_secret "The Client Secret on that same page"
    ask contabo_user "The Username of those API credentials — a generated address of its own, not the one you log in with"
    ask -s contabo_password "That API user's own password: the Send link button on that page mails a link to set it.
Neither the panel password nor the Client Secret"
    cfg_set ".contabo[\"$t\"].client_id" "$contabo_client_id" \
      && cfg_set ".contabo[\"$t\"].client_secret" "$contabo_client_secret" \
      && cfg_set ".contabo[\"$t\"].user" "$contabo_user" \
      && cfg_set ".contabo[\"$t\"].password" "$contabo_password" || return 1
    added=$((added + 1))
  done
  [ -z "$(cfg '.contabo // {} | keys[]')" ] || check_creds contabo
}
init_tailscale() {
  local line tailscale_client_id=$TAILSCALE_OAUTH_CLIENT_ID tailscale_client_secret=$TAILSCALE_OAUTH_CLIENT_SECRET
  ask tailscale_client_id "Tailscale OAuth client. Declare the tag first, otherwise the client form has no tag field:
  Access controls -> JSON editor -> add \"tag:dev\": [\"autogroup:admin\"] to tagOwners -> Save (Definitions -> Tags lists it).
Then Settings -> OAuth clients -> Generate: scopes Auth Keys (Write) and Devices Core (Write), Tags -> tag:dev. A client made before the tag existed must be regenerated.
Leave empty to create the client now from an API access token (Settings -> Keys -> Generate access token).
For ./node-ctl expose (Tailscale Funnel), also: JSON editor -> \"nodeAttrs\": [{\"target\": [\"tag:dev\"], \"attr\": [\"funnel\"]}], and DNS -> HTTPS Certificates -> Enable."
  if [ -z "$tailscale_client_id" ]; then
    ask -s TS_API_KEY "Tailscale API access token (delete it in the console once init is done)"
    while IFS= read -r line; do # the script prints the pair as ID=... and SECRET=... lines
      case $line in
        TAILSCALE_OAUTH_CLIENT_ID=*) tailscale_client_id=${line#*=} ;;
        TAILSCALE_OAUTH_CLIENT_SECRET=*) tailscale_client_secret=${line#*=} ;;
      esac
    done < <(TS_API_KEY=$TS_API_KEY scripts/tailscale-oauth-client.sh)
  else
    ask -s tailscale_client_secret "Its client secret (shown once when the client was created)"
  fi
  cfg_set .tailscale.client_id "$tailscale_client_id" && cfg_set .tailscale.client_secret "$tailscale_client_secret" \
    && check_creds tailscale
}
init_restic() {
  # shellcheck disable=SC2153 # the upper-case names are set by load_config's eval
  local restic_repository=$RESTIC_REPOSITORY restic_access_key_id=$AWS_ACCESS_KEY_ID \
        restic_secret_access_key=$AWS_SECRET_ACCESS_KEY restic_password=$RESTIC_PASSWORD
  ask restic_repository "Optional: S3-compatible bucket for backup/archive/restore, as s3:https://ENDPOINT/BUCKET.
Hetzner: console -> Object Storage -> Create bucket (region of your machines, e.g. nbg1) -> Manage credentials -> Generate.
Empty = no archives (stop/start still keep the whole machine in its disk snapshot)."
  [ -n "$restic_repository" ] || { cfg_set .restic.repository ""; return; }
  ask -s restic_access_key_id "S3 access key"
  ask -s restic_secret_access_key "S3 secret key"
  ask -s restic_password "Password every archive is encrypted with; losing it loses the archives. Empty = generate one"
  if [ -z "$restic_password" ]; then
    restic_password=$(head -c 200 /dev/urandom | LC_ALL=C tr -dc A-Za-z0-9)
    info "generated restic.password, keep a copy of $CONFIG_FILE"
  fi
  cfg_set .restic.repository "$restic_repository" && cfg_set .restic.access_key_id "$restic_access_key_id" \
    && cfg_set .restic.secret_access_key "$restic_secret_access_key" && cfg_set .restic.password "$restic_password" \
    && check_creds restic
}

ensure_config_writable() { # both init and accounts write node-ctl.yaml, seeding it from the example
  [ -f node-ctl.example.yaml ] || die "node-ctl.example.yaml is missing"
  command -v yq >/dev/null || die "yq is not installed; it writes $CONFIG_FILE (brew install yq)"
}

# `init` walks every step, so an empty tag there means "skip this cloud"; `accounts add` was asked for
# one account, so the first empty tag re-asks instead of quietly ending the dialogue.
ACCOUNTS_ADD=''
must_add() { # must_add <accounts added so far>: true when an empty tag has to be asked again
  [ "$ACCOUNTS_ADD" = 1 ] && [ "$1" -eq 0 ] && warn "a tag is needed to add an account; Ctrl-C to leave without one"
}
empty_means() { # empty_means <accounts added so far> <what empty means when the step is optional>
  if [ "$ACCOUNTS_ADD" = 1 ] && [ "$1" -eq 0 ]; then echo "A tag is needed"; else echo "$2"; fi
}
# A tag is free text, but changing a configured one, adding one or stopping is a choice: where a menu
# can be drawn it is one, and "a new account" asks for the tag the way ask does everywhere else.
ask_tag() { # ask_tag <var> <hint> <configured tags> <accounts added so far> <Empty = what stopping means>
  local t answer stop=${5#Empty = } MENU_VALUES=() MENU_LINES=()
  [ "$ACCOUNTS_ADD" != 1 ] || [ "$4" -ne 0 ] || stop=''
  if menu_driven && { [ -n "$3" ] || { [ -n "$stop" ] && [ -z "${!1:-}" ]; }; }; then
    for t in $3; do MENU_VALUES[${#MENU_VALUES[@]}]=$t; MENU_LINES[${#MENU_LINES[@]}]=" $t: change it"; done
    MENU_VALUES[${#MENU_VALUES[@]}]=+; MENU_LINES[${#MENU_LINES[@]}]=' a new account: type its tag'
    if [ -n "$stop" ]; then MENU_VALUES[${#MENU_VALUES[@]}]=''; MENU_LINES[${#MENU_LINES[@]}]=" $stop"; fi
    close_renderer
    printf '\n%s\n' "$2" >&2
    answer=$(menu account "$([ -n "$stop" ] || echo +)") || die "aborted"
    [ "$answer" = + ] || { export "$1=$answer"; return; }
    ask "$1" "The new account's tag: lowercase letters, digits and dashes"
    return
  fi
  ask "$1" "$2${3:+
Configured: $(paste -s -d ' ' - <<< "$3"); a tag of these changes it.} $(empty_means "$4" "$5")"
}

INIT_FORCE=0
init_step() { # init_step <step>: a working value is kept; otherwise the step is asked until its check passes
  if [ "$INIT_FORCE" -eq 0 ] && "valid_$1"; then action_log "configured and working, kept (./node-ctl init $1 to change)"; return; fi
  until "init_$1"; do info "-> try again"; done
}

cmd_init() { # init [step ...]: named steps are asked again even when their values work
  local step steps=(ssh link gitkey hetzner contabo tailscale restic)
  INIT_FORCE=$#
  [ $# -eq 0 ] || steps=("$@")
  ensure_config_writable
  for step in "${steps[@]}"; do
    declare -F "init_$step" >/dev/null || die "unknown step: $step (ssh link gitkey hetzner contabo tailscale restic)"
  done
  info "Writing $CONFIG_FILE after every step; a failed check repeats the step, Ctrl-C keeps what is saved so far."
  plan "${steps[@]}" "Apply Terraform"
  for step in "${steps[@]}"; do with_action "$step" "$step" init_step "$step"; done
  info "credentials verified; registering the ssh key with Hetzner"
  apply
  info "done: ./node-ctl create dev1"
}

check_host() {
  local t
  for t in terraform jq yq curl node ssh; do probe "$t" "" "not installed" command -v "$t"; done
  probe restic "" "not installed: archives cannot be verified (brew install restic)" command -v restic
  [ -z "$(cfg '.contabo // {} | keys[]')" ] || probe uuidgen "" "not installed: every Contabo API request needs a request id" command -v uuidgen
  probe "ssh key" "$SSH_PUBLIC_KEY_FILE" "unreadable: $SSH_PUBLIC_KEY_FILE (ssh_public_key_file in $CONFIG_FILE)" test -r "$SSH_PUBLIC_KEY_FILE"
  probe "ssh-agent" "key loaded" "refused the key $SSH_PUBLIC_KEY_FILE" ensure_key
}
check_config() {
  local i v
  probe "$CONFIG_FILE" "" "missing: run ./node-ctl init" test -f "$CONFIG_FILE"
  probe accounts "$(account_labels | paste -s -d ' ' -)" "no account: run ./node-ctl init hetzner, or ./node-ctl init contabo" test -n "$(accounts)"
  probe tailscale.client_id "" "empty: run ./node-ctl init" test -n "${TAILSCALE_OAUTH_CLIENT_ID:-}"
  probe tailscale.client_secret "" "empty: run ./node-ctl init" test -n "${TAILSCALE_OAUTH_CLIENT_SECRET:-}"
  for i in 0 1 2 3; do # archives are optional: an empty value is a skip, never a failure
    v=${RESTIC_VARS[i]}
    if [ -n "${!v:-}" ]; then probe "${RESTIC_KEYS[i]}" "" "" true
    else probe "${RESTIC_KEYS[i]}" "empty: archives disabled (./node-ctl init restic)" "" true; fi
  done
}
check_tailnet() { # this host's daemon, then a running machine when there is one to reach
  local cli name
  ! cli=$(tailscale_cli) || probe "Tailscale on this host" "" "not running ($cli up)" "$cli" status
  name=$(running_machines | head -1)
  [ -n "$name" ] || return 0
  probe "node-ctl-user@$name" "answers" "not reachable: Tailscale not connected, or MagicDNS off on this host" \
    tssh -o ConnectTimeout=5 -o BatchMode=yes "node-ctl-user@$(addr "$name")" true
}
creds_group() { check_creds || { FAIL_MESSAGE="a credential was rejected"; return 1; }; }
cmd_check() {
  local again="then run ./node-ctl check again"
  plan "Host" "Config $CONFIG_FILE" "Credentials" "Tailnet"
  with_action "Host" host group check_host || true
  with_action "Config $CONFIG_FILE" config group check_config || true
  [ "$FAILED" -eq 0 ] || die "fix the failed checks (or run ./node-ctl init), $again"
  with_action "Credentials" credentials creds_group || die "fix the failed checks (or run ./node-ctl init), $again"
  with_action "Tailnet" tailnet group check_tailnet || die "fix the failed checks, $again"
  echo "all good"
}

cmd=${1:-}
[ $# -eq 0 ] || shift
# Help is answered before anything else can fail. ssh hands everything after the name to the
# machine (ssh dev1 ls --help), so only its first argument can ask.
case $cmd in
  -h | --help) usage; exit ;;
  help) case ${1:-} in '') usage ;; -h | --help) cmd_help help ;; *) cmd_help "$1" ;; esac; exit ;;
  ssh) case ${1:-} in -h | --help) cmd_help ssh; exit ;; esac ;;
  *) for a in "$@"; do case $a in -h | --help) cmd_help "$cmd"; exit ;; esac; done ;;
esac
load_config
case $PROGRESS in
  auto) if [ -n "$TTY" ] && [ -z "${CI:-}" ]; then PROGRESS='tty'; else PROGRESS='plain'; fi ;;
  tty | plain | json) ;;
  *) die "--progress must be auto, tty, plain or json, got: $PROGRESS" ;;
esac
case $cmd in init | accounts) [ "$PROGRESS" = json ] || PROGRESS=plain ;; esac # a dialogue cannot share the screen with a live region
# A command that acts on one machine asks which on a terminal when no name comes first; off one
# its own usage error stands. The states are the ones the command can act on. stop and start also
# take every machine they can act on (--all), which a bare call offers as the first line.
states=- all=''
targeted() { # targeted <arg ...>: whether they already say what to act on, a name or --all, wherever it stands among the options
  while [ $# -gt 0 ]; do
    case $1 in
      --all) return 0 ;;
      --till | --type) case ${2:--} in -*) ;; *) shift ;; esac ;; # their value is no machine name
      -*) ;;
      *) return 0 ;;
    esac
    shift
  done
  return 1
}
case $cmd in
  stop) states=running; [ $# -gt 0 ] || all="every running machine" ;;
  start) states=stopped; [ $# -gt 0 ] || all="every stopped machine" ;;
  ssh | backup | archive | gitkey | hostkeys | cato) states=running ;;
  resize | volume) states='running stopped' ;;
  destroy | ports | expose | restore) states='' ;;
esac
if [ "$states" != - ] && [ -t 0 ] && ! targeted "$@"; then
  name=$(pick_machine "$states" "$all") || exit 1
  set -- "$name" "$@"
fi
case $cmd in create|start|stop|destroy|expose|backup|archive|restore|ssh|load|gitkey|hostkeys|cato|volume) ensure_key; ensure_tailscale ;; esac
case $cmd in
  create|stop|start|resize|volume|destroy|list|load|ports|expose|backup|archive|restore|ssh|gitkey|hostkeys|autostop|cato|apply|test|check|init|accounts|version) "cmd_$cmd" "$@" ;;
  --version) cmd_version ;;
  '') usage >&2; exit 1 ;;
  *) warn "unknown command: $cmd"; usage >&2; exit 1 ;;
esac; exit # on one line: bash reads it with the case and never touches the file again, which may have grown under a long command
